/-- Trial `n` of a ground FTS fold: `left ‖ header` (32 bytes), the nonce pad `n ‖ 0`, then `right`. -/
def trialInput (pre : List UInt8) (n : Nat) (right : List UInt8) : List UInt8 := pre ++ nonceBytes n ++ right
/-- Zero bits demanded of coordinate `k`'s heap-8..15 FTS nodes (S1 point P1: 1 on coordinates 0, 1; 2 on 2..8). -/
def ftsWidth (k : Nat) : Nat := if k ≤ 1 then 1 else 2
/-- A heap-8..15 FTS node keeps the low half of its answer; the trial passes iff that half's top `b` bits are 0. -/
def zeroOk (b : Nat) (a : HashOutput) : Bool := decide ((a.extractLsb' 0 128).toNat < 2 ^ (128 - b))
/-- First-nonce search from trial `n` with `fuel` further trials; the last trial is kept. -/
def search (b : Nat) (pre right : List UInt8) : Nat → Nat → M (Nat × HashOutput)
  | 0, n => do
      let a ← publicHash (trialInput pre n right)
      pure (n, a)
  | fuel + 1, n => do
      let a ← publicHash (trialInput pre n right)
      if zeroOk b a then pure (n, a) else search b pre right fuel (n + 1)
/-- Trials `0 .. 128 * 2^b - 1`. -/
def FUEL (b : Nat) : Nat := 128 * 2 ^ b - 1
/-- The ground fold of a heap-8..15 FTS node demanding `b` zero bits. -/
def groundFold (b : Nat) (pre right : List UInt8) : M (Nat × HashOutput) := search b pre right (FUEL b) 0

