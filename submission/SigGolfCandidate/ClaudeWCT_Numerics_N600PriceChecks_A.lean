open Finset

def profileList (i : Fin 434) : List Nat := profiles[i.val]?.getD []

def profileVector (K r : Nat) (ms : List Nat) (a : Fin 21) : Nat :=
  if a.val = 0 then K - ((r - used ms) + groups ms)
  else if a.val = 1 then r - used ms else ms[a.val - 2]?.getD 0

def profileChecks : Bool := [64, 128].all fun K => (List.range 21).all fun r =>
  profiles.all fun ms => if used ms ≤ r then
    decide ((∑ a : Fin 21, profileVector K r ms a) = K ∧
      (∑ a : Fin 21, profileVector K r ms a * a.val) = r ∧
      Nat.multinomial univ (profileVector K r ms) *
        (r.factorial / ∏ a : Fin 21, a.val.factorial ^ profileVector K r ms a) =
          profileWeight K r ms) else true

/-! Kernel-friendly form of `profileChecks`: the `Fin 21` sums and products become folds over
`List.range 21` with primitive `Nat` arithmetic (theorem `profileChecks_eq_fast`). -/

/-- `profileVector` on a natural index. -/
def profileVectorN (K r : Nat) (ms : List Nat) (i : Nat) : Nat :=
  if i = 0 then K - ((r - used ms) + groups ms)
  else if i = 1 then r - used ms else ms[i - 2]?.getD 0

def pcSum21 (f : Nat → Nat) : Nat := (List.range 21).foldr (fun i s => f i + s) 0
def pcProd21 (f : Nat → Nat) : Nat := (List.range 21).foldr (fun i s => f i * s) 1

def profileChecksFast : Bool := [64, 128].all fun K => (List.range 21).all fun r =>
  profiles.all fun ms => if used ms ≤ r then
    decide (pcSum21 (profileVectorN K r ms) = K ∧
      pcSum21 (fun i => profileVectorN K r ms i * i) = r ∧
      fact (pcSum21 (profileVectorN K r ms)) / pcProd21 (fun i => fact (profileVectorN K r ms i)) *
        (fact r / pcProd21 (fun i => fact i ^ profileVectorN K r ms i)) =
          profileWeight K r ms) else true

theorem pc_foldr_range_add (f : Nat → Nat) (n : Nat) :
    (List.range n).foldr (fun i s => f i + s) 0 = ∑ i ∈ range n, f i := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [List.range_succ, List.foldr_append, Finset.sum_range_succ, ← ih]
    simp only [List.foldr_cons, List.foldr_nil, Nat.add_zero]
    generalize f n = c
    induction (List.range n) generalizing c with
    | nil => simp
    | cons x xs ihx => simp only [List.foldr_cons]; rw [ihx]; omega

theorem pc_foldr_range_mul (f : Nat → Nat) (n : Nat) :
    (List.range n).foldr (fun i s => f i * s) 1 = ∏ i ∈ range n, f i := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [List.range_succ, List.foldr_append, Finset.prod_range_succ, ← ih]
    simp only [List.foldr_cons, List.foldr_nil, Nat.mul_one]
    generalize f n = c
    induction (List.range n) generalizing c with
    | nil => simp
    | cons x xs ihx => simp only [List.foldr_cons]; rw [ihx, Nat.mul_assoc]

theorem pcSum21_eq (f : Nat → Nat) : pcSum21 f = ∑ a : Fin 21, f a.val := by
  rw [pcSum21, pc_foldr_range_add, Fin.sum_univ_eq_sum_range]

theorem pcProd21_eq (f : Nat → Nat) : pcProd21 f = ∏ a : Fin 21, f a.val := by
  rw [pcProd21, pc_foldr_range_mul, Fin.prod_univ_eq_prod_range]

theorem pc_fact_eq_factorial (n : Nat) : fact n = n.factorial := by
  induction n with
  | zero => rfl
  | succ n ih => rw [fact, ih, Nat.factorial_succ]

theorem profileVector_eq_N (K r : Nat) (ms : List Nat) (a : Fin 21) :
    profileVector K r ms a = profileVectorN K r ms a.val := rfl

theorem profile_decide_eq (K r : Nat) (ms : List Nat) :
    decide ((∑ a : Fin 21, profileVector K r ms a) = K ∧
      (∑ a : Fin 21, profileVector K r ms a * a.val) = r ∧
      Nat.multinomial univ (profileVector K r ms) *
        (r.factorial / ∏ a : Fin 21, a.val.factorial ^ profileVector K r ms a) =
          profileWeight K r ms) =
    decide (pcSum21 (profileVectorN K r ms) = K ∧
      pcSum21 (fun i => profileVectorN K r ms i * i) = r ∧
      fact (pcSum21 (profileVectorN K r ms)) / pcProd21 (fun i => fact (profileVectorN K r ms i)) *
        (fact r / pcProd21 (fun i => fact i ^ profileVectorN K r ms i)) =
          profileWeight K r ms) := by
  apply decide_eq_decide.mpr
  rw [pcSum21_eq, pcSum21_eq, pcProd21_eq, pcProd21_eq, pc_fact_eq_factorial, pc_fact_eq_factorial,
    Nat.multinomial]
  simp only [profileVector_eq_N, pc_fact_eq_factorial]

theorem profileChecks_eq_fast : profileChecks = profileChecksFast := by
  unfold profileChecks profileChecksFast
  simp only [profile_decide_eq]

theorem profile_checks : profileChecks = true := by
  rw [profileChecks_eq_fast]; decide +kernel



theorem profile_nodup : profiles.Nodup := by decide +kernel

theorem profile_lengths : ∀ i : Fin 434, (profileList i).length = 7 := by decide +kernel

#print axioms profile_checks
#print axioms profile_nodup

end ClaudeWCT.Numerics.SharedPathReflection

