def binRunsCheck : Bool := binRuns.all fun e =>
  let lo := e.1
  let hi := e.2.1
  let b := e.2.2
  decide (1 ≤ lo ∧ lo ≤ hi ∧ hi * 100 ^ b ≤ 101 ^ b ∧
    100 * 101 ^ b ≤ 101 * lo * 100 ^ b)

theorem bin_indices_checked : binPairs.map Prod.fst = List.range' 1 11260 := by decide +kernel

theorem bin_runs_checked : binRunsCheck = true := by decide +kernel

def additionBounds : Bool := (List.range 2049).all fun d =>
  let b := additionBins[d]?.getD 0
  decide (100 ^ b * (101 ^ d + 100 ^ d) ≤ 101 ^ (b + d) ∧
    100 * 101 ^ (b + d) ≤ 101 * 100 ^ b * (101 ^ d + 100 ^ d))

def additionChunk (block : Nat) : Bool := (List.range 128).all fun j =>
  let d := 128 * block + j
  if d < 2049 then
    let b := additionBins[d]?.getD 0
    decide (100 ^ b * (101 ^ d + 100 ^ d) ≤ 101 ^ (b + d) ∧
      100 * 101 ^ (b + d) ≤ 101 * 100 ^ b * (101 ^ d + 100 ^ d))
  else true

/-- One pass over `additionBins` (no indexed lookups); implies every `additionChunk`. -/
def additionFast : Bool := additionBins.toList.zipIdx.all fun e =>
  decide (100 ^ e.1 * (101 ^ e.2 + 100 ^ e.2) ≤ 101 ^ (e.1 + e.2) ∧
    100 * 101 ^ (e.1 + e.2) ≤ 101 * 100 ^ e.1 * (101 ^ e.2 + 100 ^ e.2))

theorem addition_fast_ok : additionFast = true := by decide +kernel

theorem additionChunk_of_fast (block : Nat) : additionChunk block = true := by
  apply List.all_eq_true.mpr
  intro j _
  dsimp only
  split_ifs with hd
  · have hl : 128 * block + j < additionBins.toList.length := by
      rw [Array.length_toList, addition_bin_count]; exact hd
    have he : (additionBins.toList[128 * block + j], 128 * block + j) ∈ additionBins.toList.zipIdx := by
      have hh := List.getElem_mem (l := additionBins.toList.zipIdx) (n := 128 * block + j)
        (by simpa using hl)
      simpa only [List.getElem_zipIdx, Nat.zero_add] using hh
    have h := List.all_eq_true.mp addition_fast_ok _ he
    have hv : additionBins[128 * block + j]?.getD 0 = additionBins.toList[128 * block + j] := by
      rw [← Array.getElem?_toList, List.getElem?_eq_getElem hl]
      rfl
    rw [hv]
    exact h
  · rfl

theorem addition_chunk_0 : additionChunk 0 = true := additionChunk_of_fast 0

