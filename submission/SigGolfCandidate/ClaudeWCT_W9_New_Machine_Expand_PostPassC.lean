      t.getReg .x29 = BitVec.ofNat 64 0x301000 ∧ t.getReg .x30 = BitVec.ofNat 64 11792 ∧
      RegsExcept s t [.x6, .x7, .x10, .x28, .x29, .x30] ∧ ∀ A, t.getMem A = s.getMem A := by
  have hl := leafOf_lt (s.getMem (BitVec.ofNat 64 0x20160))
  refine ⟨_, symRun_sound RDA hc s hpc (by simp [RDA.res, Result.obligs, Oblig.all, rv_simp, accessValid_iff,
    MEMORY_BYTES]), ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simp only [Result.toState_pc, RDA.res, E.eval, BinOp.eval, BitVec.toNat_ofNat, Nat.reduceMod]
    rw [show (131424#64 : Word) = BitVec.ofNat 64 0x20160 from rfl, shr52, and63 _ (by omega), ofNat_shl,
      ofNat_add_ofNat]
    rw [show leafOf (s.getMem (BitVec.ofNat 64 0x20160)) % 64 * 2 ^ 7 + 204408 =
      0x1000 + 4 * (50078 + 32 * (leafOf (s.getMem (BitVec.ofNat 64 0x20160)) % 64)) by omega]
    exact pcOf_and_not1 _
  · simp only [Result.toState_getReg, RDA.res, RegFile.get, E.eval, BinOp.eval, BitVec.toNat_ofNat, Nat.reduceMod]
    rw [show (131424#64 : Word) = BitVec.ofNat 64 0x20160 from rfl, shr52]
  · simp [RDA.res, RegFile.get, E.eval]
  · simp [RDA.res, RegFile.get, E.eval]
  · intro x hx
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hx
    simp only [Result.toState_getReg, RDA.res]
    cases x <;> simp_all [RegFile.get, E.eval] <;> rfl
  · intro A; rfl

theorem dB_spec {im : Image} (hc : CodeAt im (pcOf 50070) cDB) (s : MachineState) (hpc : s.pc = pcOf 50070)
    (leaf : Nat) (hl : leaf < 4096) (h10 : s.getReg .x10 = BitVec.ofNat 64 leaf) :
    ∃ t, Steps im s RDB.res.steps RDB.res.cycles t ∧ t.pc = pcOf (52126 + 32 * (leaf / 64 % 64)) ∧
      RegsExcept s t [.x6, .x7] ∧ ∀ A, t.getMem A = s.getMem A := by
  refine ⟨_, symRun_sound RDB hc s hpc (by simp [RDB.res, Result.obligs, Oblig.all]), ?_, ?_, ?_⟩
  · simp only [Result.toState_pc, RDB.res, E.eval, BinOp.eval, BitVec.toNat_ofNat, Nat.reduceMod, h10]
    rw [ofNat_shr _ _ (by omega), and63 _ (lt_of_le_of_lt (Nat.div_le_self _ _) (by omega)), ofNat_shl,
      ofNat_add_ofNat]
    have e : ∀ x y : Nat, x = 0x1000 + 4 * y → BitVec.ofNat 64 x &&& ~~~1#64 = pcOf y := by
      rintro x y rfl; exact pcOf_and_not1 y
    exact e _ _ (by simp only [Nat.reducePow, Nat.reduceMod]; omega)
  · intro x hx
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hx
    simp only [Result.toState_getReg, RDB.res]
    cases x <;> simp_all [RegFile.get, E.eval] <;> rfl
  · intro A; rfl

theorem j_spec {im : Image} (hc : CodeAt im (pcOf 50077) cJ) (s : MachineState) (hpc : s.pc = pcOf 50077) :
    ∃ t, Steps im s RJ.res.steps RJ.res.cycles t ∧ t.pc = pcOf 54174 ∧ RegsExcept s t [] ∧
      ∀ A, t.getMem A = s.getMem A := by
  refine ⟨_, symRun_sound RJ hc s hpc (by simp [RJ.res, Result.obligs, Oblig.all]), ?_, ?_, ?_⟩
  · simp [RJ.res, E.eval]
  · intro x _
    simp only [Result.toState_getReg, RJ.res]
    cases x <;> simp [RegFile.get, E.eval] <;> rfl
  · intro A; rfl

/-! ### The whole post-pass as a memory map -/
/-- Memory after the post-pass, from the memory `M` at its entry (`leaf` = the top leaf). -/
def ppMem (leaf : Nat) (M : Nat → Word) : Nat → Word :=
  let M1 := fcp M 11768 0x300000 432
  let M2 := fcp M1 11000 0x301000 96
  let M3 := bmv M2 26088 16 202
  let M4 := bmv M3 24456 32 90
  let M5 := bmv M4 23720 48 1063
  let M6 := bmv M5 10560 1224 958
  let M7 := zfill M6 11792 435
  let M8 := vFun M7
  let M9 := rowFun (rowsA.getD (leaf % 64) []) M8
  rowFun (rowsB.getD (leaf / 64 % 64) []) M9

theorem vFun_20160 (M : Nat → Word) : vFun M 0x20160 = M 0x20160 := by
  unfold vFun
  rw [show vTable.reverse.find? (fun e => decide (e.1 = 0x20160)) = none by decide +kernel]

/-- `mem[0x20160]` is not touched before the dispatch reads it. -/
theorem stages_20160 (M : Nat → Word) :
    zfill (bmv (bmv (bmv (bmv (fcp (fcp M 11768 0x300000 432) 11000 0x301000 96) 26088 16 202) 24456 32 90)
      23720 48 1063) 10560 1224 958) 11792 435 0x20160 = M 0x20160 := by
  simp only [zfill, bmv, fcp]
  simp (config := { decide := true })

theorem vFun_congr (M1 M2 : Nat → Word) (h : ∀ B < 2 ^ 64, M1 B = M2 B) (A : Nat) (hA : A < 2 ^ 64) :
    vFun M1 A = vFun M2 A := by
  unfold vFun
  split
  · rename_i e he
    exact h _ (vTable_bounds e (List.mem_of_find?_eq_some he)).2
  · exact h A hA

theorem rowFun_congr (pairs : List (Nat × Nat)) (hp : ∀ e ∈ pairs, e.1 < 4096 ∧ e.2 < 4096) (M1 M2 : Nat → Word)
    (h : ∀ B < 2 ^ 64, M1 B = M2 B) (A : Nat) (hA : A < 2 ^ 64) : rowFun pairs M1 A = rowFun pairs M2 A := by
  unfold rowFun
  split
  · rename_i e he
    have := hp e (List.mem_reverse.mp (List.mem_of_find?_eq_some he))
    exact h _ (by omega)
  · exact h A hA

/-- Cycles of the whole post-pass. -/
def ppCycles : Nat :=
  6 + 5 * 432 + 6 + 5 * 96 + 5 + 5 * 202 + 5 + 5 * 90 + 5 + 5 * 1063 + 5 + 5 * 958 + 4 + 3 * 435 + 586 +
    RDA.res.cycles + 25 + RDB.res.cycles + 25 + RJ.res.cycles

theorem pp_spec (s : MachineState) (hpc : s.pc = pcOf 49400) :
    ∃ t, Steps Images.expandImage s 16205 ppCycles t ∧ t.pc = pcOf 54174 ∧
      RegsExcept s t [.x6, .x7, .x10, .x28, .x29, .x30] ∧
      ∀ A < 2 ^ 64, t.getMem (BitVec.ofNat 64 A) =
        ppMem (leafOf (s.getMem (BitVec.ofNat 64 0x20160))) (fun B => s.getMem (BitVec.ofNat 64 B)) A := by
  -- save 1
  obtain ⟨t1, st1, pt1, a1, b1, c1, rt1, mt1⟩ := pro_spec run_pro1 code_pro1 (Or.inl rfl) s hpc
  obtain ⟨u1, su1, ru1, I1⟩ := f_loop (Or.inl rfl) code_f1 t1 (fun B => s.getMem (BitVec.ofNat 64 B)) 11768 0x300000
    432 (by decide) pt1 a1 b1 c1 (fun A _ => by rw [mt1]) (by decide) (by decide) (by decide) (by decide) (by decide)
    432 le_rfl
  have pu1 : u1.pc = pcOf 49411 := by rw [I1.pc, if_neg (by decide)]
  -- save 2
  obtain ⟨t2, st2, pt2, a2, b2, c2, rt2, mt2⟩ := pro_spec run_pro2 code_pro2 (Or.inl rfl) u1 pu1
  obtain ⟨u2, su2, ru2, I2⟩ := f_loop (Or.inr rfl) code_f2 t2
    (fcp (fun B => s.getMem (BitVec.ofNat 64 B)) 11768 0x300000 432) 11000 0x301000 96
    (by decide) pt2 a2 b2 c2 (fun A hA => by rw [mt2, I1.mem A hA]) (by decide) (by decide) (by decide) (by decide)
    (by decide) 96 le_rfl
  have pu2 : u2.pc = pcOf 49422 := by rw [I2.pc, if_neg (by decide)]
  -- move 1
  obtain ⟨t3, st3, pt3, a3, b3, c3, rt3, mt3⟩ := pro_spec run_mv1 code_mv1 (Or.inr rfl) u2 pu2
  obtain ⟨u3, su3, ru3, I3⟩ := m_loop (Or.inl rfl) code_m1 t3
    (fcp (fcp (fun B => s.getMem (BitVec.ofNat 64 B)) 11768 0x300000 432) 11000 0x301000 96) 26088 16 24472 202
    (by decide) (by decide) pt3 a3 b3 c3 (fun A hA => by rw [mt3, I2.mem A hA]) (by decide) (by decide) (by decide)
    (by decide) (by decide) 202 le_rfl
  have pu3 : u3.pc = pcOf 49432 := by rw [I3.pc, if_neg (by decide)]
  -- move 2
  obtain ⟨t4, st4, pt4, a4, b4, c4, rt4, mt4⟩ := pro_spec run_mv2 code_mv2 (Or.inr rfl) u3 pu3
  obtain ⟨u4, su4, ru4, I4⟩ := m_loop (Or.inr (Or.inl rfl)) code_m2 t4
    (bmv (fcp (fcp (fun B => s.getMem (BitVec.ofNat 64 B)) 11768 0x300000 432) 11000 0x301000 96) 26088 16 202)
    24456 32 23736 90 (by decide) (by decide) pt4 a4 b4 c4 (fun A hA => by rw [mt4, I3.mem A hA]) (by decide)
    (by decide) (by decide) (by decide) (by decide) 90 le_rfl
  have pu4 : u4.pc = pcOf 49442 := by rw [I4.pc, if_neg (by decide)]
  -- move 3
  obtain ⟨t5, st5, pt5, a5, b5, c5, rt5, mt5⟩ := pro_spec run_mv3 code_mv3 (Or.inr rfl) u4 pu4
  obtain ⟨u5, su5, ru5, I5⟩ := m_loop (Or.inr (Or.inr (Or.inl rfl))) code_m3 t5
    (bmv (bmv (fcp (fcp (fun B => s.getMem (BitVec.ofNat 64 B)) 11768 0x300000 432) 11000 0x301000 96) 26088 16 202)
      24456 32 90) 23720 48 15216 1063 (by decide)
    (by decide) pt5 a5 b5 c5 (fun A hA => by rw [mt5, I4.mem A hA]) (by decide) (by decide) (by decide) (by decide)
    (by decide) 1063 le_rfl
  have pu5 : u5.pc = pcOf 49452 := by rw [I5.pc, if_neg (by decide)]
  -- move 4 (FTS block)
  obtain ⟨t6, st6, pt6, a6, b6, c6, rt6, mt6⟩ := pro_spec run_mv4 code_mv4 (Or.inr rfl) u5 pu5
  obtain ⟨u6, su6, ru6, I6⟩ := m_loop (Or.inr (Or.inr (Or.inr rfl))) code_m4 t6
    (bmv (bmv (bmv (fcp (fcp (fun B => s.getMem (BitVec.ofNat 64 B)) 11768 0x300000 432) 11000 0x301000 96) 26088
      16 202) 24456 32 90) 23720 48 1063) 10560 1224 2896 958 (by decide)
    (by decide) pt6 a6 b6 c6 (fun A hA => by rw [mt6, I5.mem A hA]) (by decide) (by decide) (by decide) (by decide)
    (by decide) 958 le_rfl
  have pu6 : u6.pc = pcOf 49462 := by rw [I6.pc, if_neg (by decide)]
  -- zero
  obtain ⟨t7, st7, pt7, rt7, rr7, mt7⟩ : ∃ t7, Steps Images.expandImage u6 4 4 t7 ∧ t7.pc = pcOf 49466 ∧
      (t7.getReg .x28 = BitVec.ofNat 64 11792 ∧ t7.getReg .x30 = BitVec.ofNat 64 15272) ∧
      RegsExcept u6 t7 [.x28, .x30] ∧ ∀ A, t7.getMem A = u6.getMem A := by
    have := symRun_sound run_zpro code_zpro u6 pu6 (by simp [zProRes, Result.obligs, Oblig.all])
    refine ⟨_, this, by simp [zProRes, E.eval], ⟨by simp [zProRes, RegFile.get, RegFile.set, E.eval],
      by simp [zProRes, RegFile.get, RegFile.set, E.eval]⟩, ?_, fun A => rfl⟩
    intro x hx
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hx
    simp only [Result.toState_getReg, zProRes]
    cases x <;> simp_all [RegFile.get, RegFile.set, RegFile.init, E.eval] <;> rfl
  obtain ⟨u7, su7, ru7, pu7', _, mu7⟩ := z_loop code_z t7
    (bmv (bmv (bmv (bmv (fcp (fcp (fun B => s.getMem (BitVec.ofNat 64 B)) 11768 0x300000 432) 11000 0x301000 96)
      26088 16 202) 24456 32 90) 23720 48 1063) 10560 1224 958) 11792 435 (by decide) pt7 rt7.1 rt7.2
    (fun A hA => by rw [mt7, I6.mem A hA]) (by decide) (by decide) 435 le_rfl
  have pu7 : u7.pc = pcOf 49469 := by rw [pu7', if_neg (by decide)]
  -- values
  obtain ⟨u8, su8, pu8, ru8, _, mu8⟩ := vals_spec code_vals u7 pu7
  -- dispatch A
  obtain ⟨u9, su9, pu9, u9_10, u9_29, u9_30, ru9, mu9⟩ := dA_spec code_DA u8 pu8
  have hleaf : u8.getMem (BitVec.ofNat 64 0x20160) = s.getMem (BitVec.ofNat 64 0x20160) := by
    rw [mu8 _ (by decide), vFun_20160, mu7 _ (by decide), stages_20160]
  rw [hleaf] at pu9 u9_10
  have hlt := leafOf_lt (s.getMem (BitVec.ofNat 64 0x20160))
  -- row A
  obtain ⟨R, hRrun, hRok⟩ := rowA_ok (leafOf (s.getMem (BitVec.ofNat 64 0x20160)) % 64) (by omega)
  obtain ⟨u10, su10, pu10, ru10, mu10⟩ := row_spec hRrun (code_rowA _ (by omega)) hRok
    (rowsA_bounds _ (by omega)) u9 pu9 u9_29 u9_30
  -- dispatch B
  obtain ⟨u11, su11, pu11, ru11, mu11⟩ := dB_spec code_DB u10 pu10 _ hlt (by rw [ru10.get (by decide), u9_10])
  -- row B
  obtain ⟨R', hR'run, hR'ok⟩ := rowB_ok (leafOf (s.getMem (BitVec.ofNat 64 0x20160)) / 64 % 64) (by omega)
  obtain ⟨u12, su12, pu12, ru12, mu12⟩ := row_spec hR'run (code_rowB _ (by omega)) hR'ok
    (rowsB_bounds _ (by omega)) u11 pu11 (by rw [ru11.get (by decide), ru10.get (by decide), u9_29])
    (by rw [ru11.get (by decide), ru10.get (by decide), u9_30])
  -- jump to the pad writer hook
  obtain ⟨u13, su13, pu13, ru13, mu13⟩ := j_spec code_J u12 pu12
  refine ⟨u13, ?_, pu13, ?_, ?_⟩
  · have hS := (((((((((((((((((((st1.trans su1).trans st2).trans su2).trans st3).trans su3).trans
      st4).trans su4).trans st5).trans su5).trans st6).trans su6).trans st7).trans su7).trans su8).trans su9).trans
      su10).trans su11).trans su12).trans su13)
    have hk : 6 + 5 * 432 + 6 + 5 * 96 + 5 + 5 * 202 + 5 + 5 * 90 + 5 + 5 * 1063 + 5 + 5 * 958 + 4 + 3 * 435 + 586 +
        RDA.res.steps + 25 + RDB.res.steps + 25 + RJ.res.steps = 16205 := by
      rw [show RDA.res.steps = 15 from rfl, show RDB.res.steps = 7 from rfl, show RJ.res.steps = 1 from rfl]
    have hc : 6 + 5 * 432 + 6 + 5 * 96 + 5 + 5 * 202 + 5 + 5 * 90 + 5 + 5 * 1063 + 5 + 5 * 958 + 4 + 3 * 435 + 586 +
        RDA.res.cycles + 25 + RDB.res.cycles + 25 + RJ.res.cycles = ppCycles := rfl
    exact Steps.of_eq hS hk hc
  · exact (((((((((((((((((((rt1.trans ru1).trans rt2).trans ru2).trans rt3).trans ru3).trans rt4).trans ru4).trans
      rt5).trans ru5).trans rt6).trans ru6).trans rr7).trans ru7).trans ru8).trans ru9).trans ru10).trans ru11).trans
      ru12).trans ru13).mono (by decide)
  · intro A hA
    rw [mu13, mu12 A hA]
    dsimp only [ppMem]
    apply rowFun_congr _ (rowsB_bounds _ (by omega)) _ _ _ A hA
    intro B hB
    rw [mu11, mu10 B hB]
    apply rowFun_congr _ (rowsA_bounds _ (by omega)) _ _ _ B hB
    intro C hC
    rw [mu9, mu8 C hC]
    apply vFun_congr _ _ _ C hC
    intro D hD
    rw [mu7 D hD]

end ClaudeWCT.W9.Machine.Expand.PostPass

