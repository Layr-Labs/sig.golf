namespace W9Drv
variable {P : SigGolfCandidate.Legacy.Hash → Prop}
open OracleComp SigGolfCandidate.Legacy SigGolfCandidate.Legacy.Riscv RiscvZkvm.Rv64
open SigGolfCandidate.Rv SigGolfCandidate.T3M SigGolfCandidate.T3M.Verify
open SigGolfCandidate.T3 (Digest HashOutput M)
open W9Machine
theorem block_steps {words : List (BitVec 32)} {p n : Nat} {r : Result}
    (hc : rOK (symRun {} words (pcOf p) n) r = true) (hl : sliceChecked p words = true)
    (hob : r.st.obl = []) (s : MachineState) (hpc : s.pc = pcOf p) :
    Steps Frozen.image s r.steps r.cycles (r.toState s) :=
  symRun_sound (rOK_eq hc) (slice_at p words hl) s hpc (by simp [Result.obligs, hob, Oblig.all])
theorem block_ecall {words : List (BitVec 32)} {p n : Nat} {r : Result}
    (hc : rOK (symRun {} words (pcOf p) n) r = true) (hl : sliceChecked p words = true)
    (hob : r.st.obl = []) (s : MachineState) (hstop : r.stop = .ecall) :
    fetch Frozen.image (r.toState s) = some (.base .ECALL) :=
  symRun_ecall (rOK_eq hc) (slice_at p words hl) s (by simp [Result.obligs, hob, Oblig.all]) hstop
theorem toState_mem_nil (r : Result) (s : MachineState) (h : r.st.mem = []) :
    (r.toState s).mem = s.mem := by
  show memEval s r.st.mem = s.mem
  rw [h]; rfl
theorem init_getReg (s : MachineState) (x : Reg) : (RegFile.init.get x).eval s = s.getReg x := by
  cases x <;> rfl
theorem glob_congr {w : ClaudeWCT.W9.T3M.WBytes} {pk : Digest} {s t : MachineState} (h : Glob [(.x5, 0)] w pk s)
    (hm : t.mem = s.mem) (h5 : t.getReg .x5 = 0) :
    Glob [(.x5, 0)] w pk t := by
  obtain ⟨-, h0, h2, h3, h4, h5'⟩ := h
  have e : ∀ A, t.getMem A = s.getMem A := fun A => congrFun hm A
  refine ⟨?_, fun j hj4 hj => (e _).trans (h0 j hj4 hj), ⟨(e _).trans h2.1, (e _).trans h2.2⟩,
    fun a ha => (e _).trans (h3 a ha), ?_, h5'.congr (fun A _ _ => e _)⟩
  · intro p hp
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
    subst hp
    exact h5
  · show (t.getMem _).toNat / 2 ^ 32 = 0
    rw [e]; exact h4
theorem idx_val (x : Word) :
    x >>> 33 = BitVec.ofNat 64 (x.toNat / 2 ^ 33) := by
  apply BitVec.eq_of_toNat_eq
  rw [BitVec.toNat_ushiftRight, Nat.shiftRight_eq_div_pow, BitVec.toNat_ofNat]
  have := x.isLt
  omega
theorem heap_val (i h : Nat) (hi : i < 2 ^ 31) :
    BitVec.ofNat 64 (2 ^ 32 * h) ||| BitVec.ofNat 64 i = BitVec.ofNat 64 (i + 2 ^ 32 * h) := by
  rw [ofNat_or_disjoint i (2 ^ 32 * h) 32 (by omega) (by simp), Nat.add_comm]
theorem word0_toNat (a : HashOutput) : (a.extractLsb' 0 64).toNat = a.toNat % 2 ^ 64 := by
  rw [BitVec.extractLsb'_toNat, Nat.shiftRight_zero]
theorem index_eq (a : HashOutput) : (a.extractLsb' 0 64).toNat / 2 ^ 33 = idxOf a := by
  rw [word0_toNat]; unfold idxOf ClaudeWCT.WCT9.digestIndex; omega
theorem setup_load (s : MachineState) (hsp : s.getReg .x2 = BitVec.ofNat 64 stackBase7) (k : Nat) :
    s.getMem ((addC (.reg .x2) (BitVec.ofNat 64 k)).eval s) = s.getMem (BitVec.ofNat 64 (stackBase7 + k)) := by
  rw [addC_eval]
  change s.getMem (s.getReg .x2 + BitVec.ofNat 64 k) = _
  rw [hsp, ofNat_add_ofNat]
set_option maxRecDepth 100000 in
theorem gate_orig (w : ClaudeWCT.W9.T3M.WBytes) {u s3 : MachineState} (hw : Orig w (fun o => o ≠ 22000) u)
    (e3 : ∀ A, s3.getMem A = u.getMem A) (m : Nat) (hm9 : m ≤ 9) (off : Nat) (hoff : off < 848) (h8 : off % 8 = 0)
    (hv : m = 9 → 768 ≤ off) : W9Machine.OrigW w s3 (regionAddr m + off) := by
  unfold W9Machine.OrigW
  rw [e3]
  have hlo : WIT ≤ regionAddr m + off := by
    unfold WIT regionAddr
    rcases Nat.lt_or_ge m 9 with h | h
    · omega
    · have := hv (by omega); omega
  have hj := hw ((regionAddr m + off - WIT) / 8) (by unfold WX regionAddr WIT at *; omega)
    (by unfold regionAddr WIT at *; omega)
  rw [show WIT + 8 * ((regionAddr m + off - WIT) / 8) = regionAddr m + off by
    unfold regionAddr WIT at *; omega] at hj
  rw [hj, wword]
  congr 1
  unfold regionAddr WIT at *
  omega
set_option maxRecDepth 100000 in
theorem gate_slot (w : ClaudeWCT.W9.T3M.WBytes) {u s3 : MachineState} (hw : Orig w (fun o => o ≠ 22000) u)
    (e3 : ∀ A, s3.getMem A = u.getMem A) (o : Nat) (ho : o = 672 ∨ o = 816) :
    DigAt s3 (regionAddr 0 + o) (wdig w (V3.regionOffset 0 + o)) := by
  have h0 := gate_orig w hw e3 0 (by decide) o (by omega) (by omega) (fun h => absurd h (by decide))
  have h1 := gate_orig w hw e3 0 (by decide) (o + 8) (by omega) (by omega) (fun h => absurd h (by decide))
  have hd := DigAt_origW h0 (by simpa only [Nat.add_assoc] using h1) (by unfold regionAddr; omega)
  rwa [show regionAddr 0 + o - 0x1020 = V3.regionOffset 0 + o by unfold regionAddr V3.regionOffset; omega] at hd
end W9Drv
end


namespace W9Drv.SharedGate
variable {P : SigGolfCandidate.Legacy.Hash → Prop}
open OracleComp SigGolfCandidate.Legacy SigGolfCandidate.Legacy.Riscv RiscvZkvm.Rv64
open SigGolfCandidate.Rv SigGolfCandidate.T3M SigGolfCandidate.T3M.Verify W9Machine
open SigGolfCandidate.T3 (Digest HashOutput M)
set_option maxRecDepth 100000
set_option maxHeartbeats 0

def gateOk (a : HashOutput) : Bool := decide (a.toNat / 2^242 % 16384 < 791)
def gCheckWords : List (BitVec 32) := [0x1803883,0x16013e83,0x11d8e063]
def gCheck : Result :=
  { W9Drv.gCheck with pc := .ite .ltu (.ld (.c (BitVec.ofNat 64 24))) (.ld (addC (.reg .x2) 352)) (.c (pcOf 70)) (.c (pcOf 7)) }
def gSetupWords : List (BitVec 32) := [0x3813e03,0x7f00db7] ++ W9Drv.gSetupWords

def gSetup : Result :=
  { W9Drv.gSetup with
    st := { W9Drv.gSetup.st with
      regs := ((W9Drv.gSetup.st.regs).set .x28 (.ld (addC (.reg .x2) 56))).set .x27 (.c 0x7f00000)
      obl := W9Drv.gSetup.st.obl ++ [.valid ⟨some (.reg .x2), 56⟩ 8] }
    pc := .c (pcOf 90)
    steps := 20
    cycles := 20 }
theorem gCheck_checked : rOK (symRun {} gCheckWords (pcOf 4) 3) gCheck = true := by decide +kernel
theorem gCheck_linked : sliceChecked 4 gCheckWords = true := by decide +kernel
theorem gSetup_linked : sliceChecked 70 gSetupWords = true := by decide +kernel
theorem gSetup_checked : rOK (symRun {} gSetupWords (pcOf 70) 20) gSetup = true := by decide +kernel

theorem gate_ult_const (a : HashOutput) :
    BitVec.ult (a.extractLsb' 192 64) (BitVec.ofNat 64 (791 * 2^50)) = gateOk a := by
  unfold gateOk
  change (a.extractLsb' 192 64).ult (BitVec.ofNat 64 (791 * 2^50)) = decide (a.toNat / 2^242 % 2^14 < 791)
  rw [← SigGolfCandidate.Research.V7Composed198Gate.gate_shift50_toNat]
  simp only [BitVec.ult, BitVec.toNat_ushiftRight, Nat.shiftRight_eq_div_pow,
    show (BitVec.ofNat 64 (791 * 2^50)).toNat = 791 * 2^50 from rfl,
    decide_eq_decide]
  omega
theorem gate_slot (w : ClaudeWCT.W9.T3M.WBytes) {u s3 : MachineState} (hw : Orig w (fun o => o ≠ 22000) u)
    (e3 : ∀ A, s3.getMem A = u.getMem A) (o : Nat) (ho : o = 672 ∨ o = 160) :
    DigAt s3 (regionAddr 0 + o) (wdig w (V3.regionOffset 0 + o)) := by
  have h0 := gate_orig w hw e3 0 (by decide) o (by omega) (by omega) (fun h => absurd h (by decide))
  have h1 := gate_orig w hw e3 0 (by decide) (o + 8) (by omega) (by omega) (fun h => absurd h (by decide))
  have hd := DigAt_origW h0 (by simpa only [Nat.add_assoc] using h1) (by unfold regionAddr; omega)
  rwa [show regionAddr 0 + o - 0x1020 = V3.regionOffset 0 + o by unfold regionAddr V3.regionOffset; omega] at hd
theorem good
    (checkLink : sliceChecked 4 gCheckWords = true)
    (setupLink : sliceChecked 70 gSetupWords = true)
    (pk : Digest) (w : ClaudeWCT.W9.T3M.WBytes) (a : HashOutput)
    (u : MachineState) (N C A : Nat) (Q : Prop)
    (K : Bool → OracleComp HashSpec Obs)
    (hu : Pre pk w a u) (hnone : K false = pure (false, 0))
    (hnext : ∀ t, SharedCoord.Pre pk w a 0 [] t →
      GoodQFor (P := P) Frozen.image t N C Q A (K true)) :
    GoodQFor (P := P) Frozen.image u (N + 23) (C + 23) Q (A + 23) (K (gateOk a)) := by
  let s1 := u
  have m1 : s1.mem = u.mem := rfl
  have r1 : ∀ x, s1.getReg x = u.getReg x := fun _ => rfl
  have pc1 : s1.pc = pcOf 4 := hu.pc
  have hob1 : gCheck.obligs s1 := by
    apply (Oblig.all_iff s1 _).mpr
    intro o ho
    simp only [gCheck, W9Drv.gCheck, List.mem_cons, List.not_mem_nil, or_false] at ho
    subst ho
    change accessValid (s1.getReg .x2 + _) 8 = true
    rw [r1, hu.sp]
    decide +kernel
  have st2 := symRun_sound (rOK_eq gCheck_checked) (slice_at _ _ checkLink) s1 pc1 hob1
  set s2 := gCheck.toState s1 with hs2
  have m2 : s2.mem = u.mem := (toState_mem_nil _ _ rfl).trans m1
  have hw0 : s1.getMem (BitVec.ofNat 64 0) = a.extractLsb' 0 64 := by
    have := hu.digest 0 (by decide +kernel)
    simpa [MachineState.getMem, m1] using this
  have hw3 : s1.getMem (BitVec.ofNat 64 24) = a.extractLsb' 192 64 := by
    have := hu.digest 3 (by decide +kernel)
    simpa [MachineState.getMem, m1] using this
  have hgate : s1.getMem ((addC (.reg .x2) 352).eval s1) = BitVec.ofNat 64 (791 * 2^50) := by
    change s1.getMem ((addC (.reg .x2) (BitVec.ofNat 64 352)).eval s1) = _
    rw [setup_load s1 hu.sp 352]
    exact hu.setupMask.gate
  have pc2 : s2.pc = if BitVec.ult (s1.getMem (BitVec.ofNat 64 24)) (s1.getMem ((addC (.reg .x2) 352).eval s1)) then pcOf 70 else pcOf 7 := by
    show (E.ite .ltu (.ld (.c (BitVec.ofNat 64 24))) (.ld (addC (.reg .x2) 352)) (.c (pcOf 70)) (.c (pcOf 7))).eval s1 = _
    rfl
  have hg : BitVec.ult (s1.getMem (BitVec.ofNat 64 24)) (s1.getMem ((addC (.reg .x2) 352).eval s1)) = gateOk a := by
    rw [hw3, hgate]
    exact gate_ult_const a
  have st2' : Steps Frozen.image s1 3 3 s2 := st2
  by_cases hok : gateOk a = true
  ·
