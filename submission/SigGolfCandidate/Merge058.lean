  ClaudeWCT.W9.T3M.BC.layerEncodingRow_length _ _ _ _ _ _ _ _
theorem encInput_hdr (e : EncIndex) :
    Extract.hdrBlock (encInput e) = bytesLE 16 ((e.1.2.2.2.2.2 ^^^ 1) ++
