set_option backward.isDefEq.respectTransparency false
variable {U : Finset HashInput} (hU : CanonGraph.canonInputs ⊆ U) (omega : CanonTable.Omega U)

theorem experimentL_tracking (g : CanonTable.HiddenF) {α β : Type}
    (published : SigGolfCandidate.T3.Cache) (program : OracleComp Interaction α)
    (finish : (α × QueryLog Requests) → M β) (hfinish : ∀ result, PublicVerdict.Only (finish result))
    (r : (β × QueryLog Requests × List Wots.Entry) × WStateL)
    (hr : fixedRun (envE (digestOf omega) (nonceOf omega)) (Guess.Fam.phi g.1 g.2)
      (experimentL hU omega published program finish) initL r ≠ 0) :
    Tracks hU omega g init (forget r.2) r.1.2.1 r.1.2.2 := by
  have h := fixed_inline_nonzero (digestOf omega) (nonceOf omega) (Guess.Fam.phi g.1 g.2) _ initL
    (SigGolfCandidate.T3.Security.BPair.consistent_empty _ _) r hr
  rw [forget_initL] at h
  change fixedRun env (Guess.Fam.phi g.1 g.2)
    (simulateQ (inlineAux omega) (experimentL hU omega published program finish)) init (r.1, forget r.2) ≠ 0 at h
  rw [inline_experimentL hU omega] at h
  exact experimentW_tracks hU omega g published program finish hfinish init (r.1, forget r.2) h

theorem experimentL_noBad (g : CanonTable.HiddenF) {α β : Type}
    (published : SigGolfCandidate.T3.Cache) (program : OracleComp Interaction α)
    (finish : (α × QueryLog Requests) → M β) (hfinish : ∀ result, PublicVerdict.Only (finish result))
    (r : (β × QueryLog Requests × List Wots.Entry) × WStateL)
    (hr : fixedRun (envE (digestOf omega) (nonceOf omega)) (Guess.Fam.phi g.1 g.2)
      (experimentL hU omega published program finish) initL r ≠ 0)
    (hno : ¬OverflowIn (wA hU omega g) r.1.2.1) : ¬Guess.Fam.Bad r.2 := by
  have h := tracked_noBad hU omega g (forget r.2) r.1.2.1 r.1.2.2
    (experimentL_tracking hU omega g published program finish hfinish r hr) hno
  exact h

theorem experimentL_guesses_nonempty (g : CanonTable.HiddenF) {α β : Type}
    (published : SigGolfCandidate.T3.Cache) (program : OracleComp Interaction α)
    (finish : (α × QueryLog Requests) → M β) (hfinish : ∀ result, PublicVerdict.Only (finish result))
    (r : (β × QueryLog Requests × List Wots.Entry) × WStateL)
    (hr : fixedRun (envE (digestOf omega) (nonceOf omega)) (Guess.Fam.phi g.1 g.2)
      (experimentL hU omega published program finish) initL r ≠ 0)
    (cell : Guess.GCoord) (hc : GuessedIn (wA hU omega g) r.1.2.1 r.1.2.2 cell) : r.2.guesses.Nonempty := by
  exact tracked_guessed hU omega g (forget r.2) r.1.2.1 r.1.2.2
    (experimentL_tracking hU omega g published program finish hfinish r hr) cell hc

