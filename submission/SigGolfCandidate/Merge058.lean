set_option backward.isDefEq.respectTransparency false
attribute [local instance] Classical.propDecidable

theorem completed_trace_expectation (adversary : Final.Paired.AdversaryP)
    (budget : Nat) (hbudget : budget ≤ 2^127) (payoff : PairedOuter.PaddedGame.TraceResult → ENNReal) :
    expectedValue (PairedSeccLaw.completedExperiment adversary budget hbudget) (fun z => payoff z.1) =
      expectedValue (PairedOuter.PaddedGame.tracedExperiment adversary budget hbudget) payoff := by
  unfold PairedSeccLaw.completedExperiment
  rw [←PMF.monad_bind_eq_bind,expectedValue_bind]
  apply congrArg
  funext result
  rw [←PMF.monad_map_eq_map,expectedValue_map]
  exact expectedValue_const (mx := PMF.uniformOfFintype SigGolfCandidate.T3.Security.SeccLaw.CompletionTables)
    (by simp) (payoff result)

theorem trace_prefix_shared (cls : SigGolfCandidate.T3.Spec.Domain → Prop)
    (adversary : Final.Paired.AdversaryP) (budget : Nat) (hbudget : budget ≤ 2^127) :
    expectedValue (PairedOuter.PaddedGame.tracedExperiment adversary budget hbudget)
      (fun result => (prefixCount cls budget result.2.2.events : ENNReal)) =
      PairedSeccLaw.expectedCharge adversary budget hbudget (fun _ => cls) := by
  rw [←completed_trace_expectation]
  unfold PairedSeccLaw.expectedCharge expectedValue
  apply tsum_congr
  intro z
  rw [PMF.probOutput_eq_apply]
  congr 1
  change (prefixCount cls budget z.1.2.2.events : ENNReal) =
    (SigGolfCandidate.T3.Security.SeccLaw.classCharge cls budget z.1.2.2.events : ENNReal)
  exact_mod_cast prefixCount_eq_classCharge cls budget z.1.2.2.events

section Generic
variable {P : Type} [Fintype P] [SampleableType P] (S : FtsBankSpecL P)
  (pay : SigGolfCandidate.T3.Cache → Digest → HashOutput → M (Option SigGolfCandidate.Research.SharedForest.Signature))
  (hrecord : ∀ published request, Prod.fst <$> S.authenticatedRecord pay published request =
    PairedOuter.FullGame.authenticatedSign published request)
include hrecord

theorem expectedBirths_le_shared (adversary : Final.Paired.AdversaryP) (budget : Nat) (hbudget : budget ≤ 2^127) :
    S.expectedBirths pay (rest adversary) budget ≤
      PairedSeccLaw.expectedCharge adversary budget hbudget (fun _ => publicClass CaseC.IsDigestInput) := by
  have hrecorded : S.expectedBirths pay (rest adversary) budget ≤
      expectedValue (S.recordedExperiment pay (rest adversary))
        (fun result => (prefixCount (publicClass CaseC.IsDigestInput) budget result.2.events : ENNReal)) := by
    unfold FtsBankSpecL.expectedBirths FtsBankSpecL.recordedExperiment
    rw [expectedValue_bind]
    apply CaseC.pmf_expectedValue_mono
    intro generated hg
    rw [MonitoredPrivate.pmf_support] at hg
    have hc := QueryRecorded.run_cost_coherent keygen QueryRecorded.initial
      QueryRecorded.initial_cost generated hg
    have h := source_expectedBirths_le_prefix S pay hrecord generated.1.2 budget
      (rest adversary generated.1.1 generated.1.2) generated.2 hc
    rw [recordedImpl_run S pay hrecord,←bank_source S pay hrecord] at h
    exact le_trans le_add_self h
  have he := congrArg (fun law : PMF (Bool × QueryRecorded.State) =>
    expectedValue law (fun result => (prefixCount (publicClass CaseC.IsDigestInput) budget result.2.events : ENNReal)))
    (recordedExperiment_eq S pay hrecord adversary budget hbudget)
  rw [PMF.monad_map_eq_map,CaseC.expectedValue_pmf_map] at he
  rw [←he] at hrecorded
  exact hrecorded.trans_eq (trace_prefix_shared _ adversary budget hbudget)
end Generic
end ClaudeWCT.W9.T3.Security.PairedBankLink
