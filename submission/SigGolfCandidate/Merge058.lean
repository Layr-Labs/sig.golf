open OracleComp OracleSpec OracleComp.EvalDist ENNReal
open SigGolfCandidate.T3 SigGolfCandidate.T3.Security SigGolfCandidate.Research.SharedForest
open SigGolfCandidate.T3.Correctness (Answers)
open SigGolfCandidate.T3.Security.BPair (AuxSpecL digestInputs rowVal)
set_option maxHeartbeats 1000000
set_option maxRecDepth 10000
set_option backward.isDefEq.respectTransparency false
attribute [local instance] Classical.propDecidable
noncomputable local instance : DecidableEq SigGolfCandidate.T3.Cache := Classical.decEq _
variable {U : Finset HashInput} (hU : CanonGraph.canonInputs ⊆ U)

theorem inline_signL (omega : CanonTable.Omega U) (published : SigGolfCandidate.T3.Cache) (request : Request) :
    simulateQ (WPair.inlineAux omega) (signL hU omega published request) = signW hU omega published request := by
  rw [signW_core]
  unfold signL
  by_cases hc : request.cache = published
  · rw [if_pos hc, if_pos hc]
    simp only [WPair.nonceReq, WPair.exposeReq, simulateQ_bind, simulateQ_spec_query, inline_searchL hU omega]
    simp only [WPair.inlineAux, WPair.inlineWith, pure_bind]
    rw [← eval_nonce hU omega 0 request.message]
    unfold signerCore
    dsimp only
    generalize evalWithAnswerFn (wA hU omega 0) (privateNonce request.message) = rho
    generalize evalWithAnswerFn (wA hU omega 0)
      (sharedDigestSearch rho request.message 0 WCT9.digestAttemptLimit) = found
    rcases found with _ | ⟨counter, output⟩
    · simp only [finishL, simulateQ_pure]
    · simp only [finishL]
      unfold signerLayersW
      generalize evalWithAnswerFn (wA hU omega 0) (searchPreparedLayers request.cache (WCT9.digestIndex output)
        (evalWithAnswerFn (wA hU omega 0) (prepareRoots (WCT9.digestIndex output)))
        (forestCommitment (wA hU omega 0) (WCT9.digestIndex output))) = layers
      rcases layers with _ | layers
      · simp only [simulateQ_pure]
      · simp only [simulateQ_bind, simulateQ_pure]
        rw [show simulateQ (WPair.inlineWith (digestOf omega) (nonceOf omega))
            (Guess.discloseAll (auxSpec := AuxSpecL) (V := Digest) (revealedCoords output)) =
          Guess.discloseAll (auxSpec := unifSpec) (V := Digest) (revealedCoords output) from
          WPair.inline_discloseAll _ _ _]
  · simp only [if_neg hc, simulateQ_pure]

end ClaudeWCT.W9.T3.Security.WPair.Paired

namespace ClaudeWCT.W9.T3.Security.WPair.Paired
open OracleComp OracleSpec OracleComp.EvalDist ENNReal
open SigGolfCandidate.T3 SigGolfCandidate.T3.Security SigGolfCandidate.Research.SharedForest
set_option maxHeartbeats 1000000
set_option maxRecDepth 10000
set_option backward.isDefEq.respectTransparency false
variable {U : Finset HashInput} (hU : CanonGraph.canonInputs ⊆ U)

theorem interactionL_pure (omega : CanonTable.Omega U) (published : SigGolfCandidate.T3.Cache)
    {α : Type} (value : α) :
    interactionL hU omega published (pure value : OracleComp Interaction α) = pure (value, [], []) := rfl

theorem interactionL_coin (omega : CanonTable.Omega U) (published : SigGolfCandidate.T3.Cache)
    {α : Type} (n : Nat) (next : Fin (n + 1) → OracleComp Interaction α) :
    interactionL hU omega published (liftM (Interaction.query (.inl (.inl n))) >>= next) =
      (WPair.coinReqL n >>= fun coin => interactionL hU omega published (next coin)) := rfl

theorem interactionL_public (omega : CanonTable.Omega U) (published : SigGolfCandidate.T3.Cache)
    {α : Type} (input : HashInput) (next : HashOutput → OracleComp Interaction α) :
    interactionL hU omega published (liftM (Interaction.query (.inl (.inr input))) >>= next) =
      (WPair.hashL hU omega input >>= fun answer => interactionL hU omega published (next answer) >>= fun rest =>
        pure (rest.1, rest.2.1, (input, answer) :: rest.2.2)) := rfl

theorem interactionL_request (omega : CanonTable.Omega U) (published : SigGolfCandidate.T3.Cache)
    {α : Type} (request : Request)
    (next : Option SigGolfCandidate.Research.SharedForest.Signature → OracleComp Interaction α) :
    interactionL hU omega published (liftM (Interaction.query (.inr request)) >>= next) =
      (signL hU omega published request >>= fun signature => interactionL hU omega published (next signature) >>= fun rest =>
        pure (rest.1, ⟨request, signature⟩ :: rest.2.1, rest.2.2)) := rfl

theorem inline_interactionL (omega : CanonTable.Omega U) (published : SigGolfCandidate.T3.Cache)
    {α : Type} (program : OracleComp Interaction α) :
    simulateQ (WPair.inlineAux omega) (interactionL hU omega published program) =
      interactionW hU omega published program := by
  induction program using OracleComp.inductionOn with
  | pure value => rw [interactionL_pure, interactionW_pure, simulateQ_pure]
  | query_bind input next ih =>
    rcases input with (n | x) | request
    · rw [interactionL_coin, interactionW_coin, simulateQ_bind, WPair.coinReqL, simulateQ_spec_query]
      exact bind_congr fun coin => ih coin
    · rw [interactionL_public, interactionW_public, simulateQ_bind, WPair.inline_hashL]
      refine bind_congr fun answer => ?_
      rw [simulateQ_bind, ih]
      exact bind_congr fun rest => by rw [simulateQ_pure]
    · rw [interactionL_request, interactionW_request, simulateQ_bind, inline_signL]
      refine bind_congr fun signature => ?_
      rw [simulateQ_bind, ih]
      exact bind_congr fun rest => by rw [simulateQ_pure]

theorem inline_experimentL (omega : CanonTable.Omega U) {α β : Type}
    (published : SigGolfCandidate.T3.Cache) (program : OracleComp Interaction α)
    (finish : (α × QueryLog Requests) → M β) :
    simulateQ (WPair.inlineAux omega) (experimentL hU omega published program finish) =
      experimentW hU omega published program finish := by
  unfold experimentL experimentW
  rw [simulateQ_bind, inline_interactionL]
  refine bind_congr fun interaction => ?_
  rw [simulateQ_bind, WPair.inline_programL]
  exact bind_congr fun result => by rw [simulateQ_pure]

end ClaudeWCT.W9.T3.Security.WPair.Paired

