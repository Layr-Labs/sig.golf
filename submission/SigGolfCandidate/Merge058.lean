  have p7' : u7.pc = pcOf (P.kb + 108) := by rw [p7, if_pos hz, if_neg (by decide), pcOf_4]
  have g25 : u7.getReg .x25 = BitVec.ofNat 64 (kS9 v + kPen v) := by
