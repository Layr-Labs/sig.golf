set_option backward.isDefEq.respectTransparency false
attribute [local instance] Classical.propDecidable
noncomputable local instance : DecidableEq SigGolfCandidate.T3.Cache := Classical.decEq _
variable {U : Finset HashInput} (hU : CanonGraph.canonInputs ⊆ U)

 theorem eval_sharedDigestSearch_succ (A : Answers) (rho : Digest) (message : Message) (counter fuel : Nat) :
    evalWithAnswerFn A (sharedDigestSearch rho message counter (fuel + 1)) =
      if digestAccepted (A (.inl (.inr (pad64 (digestInput rho message (BitVec.ofNat 32 counter)))))) = true then
        some (BitVec.ofNat 32 counter, A (.inl (.inr (pad64 (digestInput rho message (BitVec.ofNat 32 counter))))))
      else evalWithAnswerFn A (sharedDigestSearch rho message (counter + 1) fuel) := by
  rw [sharedDigestSearch, evalWithAnswerFn_bind]
  rw [show evalWithAnswerFn A (digest rho message (BitVec.ofNat 32 counter)) =
    A (.inl (.inr (pad64 (digestInput rho message (BitVec.ofNat 32 counter))))) from eval_query' A _]
  by_cases h : digestAccepted (A (.inl (.inr (pad64 (digestInput rho message (BitVec.ofNat 32 counter)))))) = true
  · simp only [h, ↓reduceIte]; rfl
  · simp only [h, ↓reduceIte, Bool.false_eq_true]

theorem inline_searchL (omega : CanonTable.Omega U) (rho : Digest) (message : Message) (counter fuel : Nat) :
    simulateQ (WPair.inlineAux omega) (searchL rho message counter fuel) =
      pure (evalWithAnswerFn (wA hU omega 0) (sharedDigestSearch rho message counter fuel)) := by
  induction fuel generalizing counter with
  | zero => rfl
  | succ fuel ih =>
    rw [eval_sharedDigestSearch_succ, answers_digest hU omega _ _
      (SigGolfCandidate.T3.Security.BPair.digestInput_mem _ _ _)]
    simp only [searchL, WPair.trialReq, simulateQ_bind, simulateQ_spec_query,
      WPair.inlineAux, WPair.inlineWith, pure_bind]
    by_cases h : digestAccepted (rowVal (digestOf omega) (pad64 (digestInput rho message (BitVec.ofNat 32 counter)))) = true
    · simp only [h, ↓reduceIte, simulateQ_pure]
    · simp only [h, ↓reduceIte, Bool.false_eq_true]
      exact ih _

theorem signW_core (omega : CanonTable.Omega U) (published : SigGolfCandidate.T3.Cache) (request : Request) :
    signW hU omega published request =
      if request.cache = published then
        match signerCore hU omega request.cache request.message with
        | none => pure none
        | some core => do
          let values ← Guess.discloseAll (auxSpec := unifSpec) (V := Digest) (revealedCoords core.2.1)
          pure (some (assembleWith (wA hU omega (liftH (overwrite (revealedCoords core.2.1) values) core.2.1)) core))
      else pure none := by
  unfold signW openedForRequest liftForRequest
  by_cases hc : request.cache = published
  · simp only [if_pos hc, openedFor, liftFor]
    cases hcore : signerCore hU omega request.cache request.message with
    | none =>
      simp only [hcore, Guess.discloseAll, List.mapM_nil, pure_bind]
      simp only [authenticatedSign, eval_privateMac_bind, if_pos hc, signPayload_answers, hcore, Option.map_none]
    | some core =>
      simp only [hcore]
      apply bind_congr
      intro values
      simp only [authenticatedSign, eval_privateMac_bind, if_pos hc, signPayload_answers, hcore, Option.map_some]
  · simp only [if_neg hc, Guess.discloseAll, List.mapM_nil, pure_bind]
    simp only [authenticatedSign, eval_privateMac_bind, if_neg hc, evalWithAnswerFn_pure]

end ClaudeWCT.W9.T3.Security.WPair.Paired

