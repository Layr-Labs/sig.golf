set_option maxHeartbeats 1000000
set_option maxRecDepth 10000
set_option backward.isDefEq.respectTransparency false
attribute [local instance] Classical.propDecidable

noncomputable def source (published : SigGolfCandidate.T3.Cache) :
    QueryImpl PairedOuter.LazyPrivate.Interaction M
  | .inl input => forwardWorld input
  | .inr request => PairedOuter.FullGame.authenticatedSign published request

def publicHandler : QueryImpl SigGolfCandidate.T3.Spec (OracleComp PairedOuter.LazyPrivate.Interaction)
  | .inl input => PairedOuter.LazyPrivate.Interaction.query (.inl input)
  | .inr _ => pure (0 : HashOutput)
def publicProgram {α : Type} (program : M α) : OracleComp PairedOuter.LazyPrivate.Interaction α :=
  simulateQ publicHandler program

theorem publicProgram_source {α : Type} (published : SigGolfCandidate.T3.Cache)
    (program : M α) (hp : PublicVerdict.Only program) :
    simulateQ (source published) (publicProgram program) = program := by
  induction program using OracleComp.inductionOn with
  | pure value => simp [publicProgram]
  | query_bind input next ih =>
      change AllQueriesSatisfy _ PublicVerdict.IsPublicHash at hp
      rw [allQueriesSatisfy_query_bind_iff] at hp
      rcases input with (sample | input) | coordinate
      · exact False.elim hp.1
      · simp only [publicProgram,simulateQ_bind,simulateQ_spec_query,publicHandler,source,forwardWorld]
        apply bind_congr
        intro answer
        exact ih answer (hp.2 answer)
      · exact False.elim hp.1

theorem logged_source {α : Type} (published : SigGolfCandidate.T3.Cache)
    (program : OracleComp PairedOuter.LazyPrivate.Interaction α) :
    simulateQ (source published) (PairedOuter.ProposalOverflow.logged program) =
      PairedOuter.FullGame.loggedWith (PairedOuter.FullGame.authenticatedSign published) program := by
  induction program using OracleComp.inductionOn with
  | pure value => rfl
  | query_bind input next ih =>
      rw [PairedOuter.ProposalOverflow.logged_query_bind,simulateQ_bind]
      rcases input with input | request
      · rw [PairedOuter.FullGame.loggedWith_world]
        simp only [simulateQ_spec_query,source]
        apply bind_congr
        intro answer
        simp only [simulateQ_bind,simulateQ_pure,PairedOuter.ProposalOverflow.logFragment,List.nil_append,
          Prod.mk.eta,bind_pure,ih]
      · rw [PairedOuter.FullGame.loggedWith_request]
        simp only [simulateQ_spec_query,source]
        apply bind_congr
        intro answer
        simp only [simulateQ_bind,simulateQ_pure,PairedOuter.ProposalOverflow.logFragment,List.singleton_append,
          ih,map_eq_bind_pure_comp,Function.comp_def]

noncomputable def rest (adversary : Final.Paired.AdversaryP) (publicKey : Digest)
    (published : SigGolfCandidate.T3.Cache) : OracleComp PairedOuter.LazyPrivate.Interaction Bool := do
  let result ← PairedOuter.ProposalOverflow.logged (adversary publicKey published)
  publicProgram (PairedOuter.GameWith.verdict PairedOuter.PaddedGame.checker publicKey result)

theorem rest_source (adversary : Final.Paired.AdversaryP) (publicKey : Digest)
    (published : SigGolfCandidate.T3.Cache) :
    simulateQ (source published) (rest adversary publicKey published) = (do
      let result ← PairedOuter.FullGame.loggedWith (PairedOuter.FullGame.authenticatedSign published)
        (adversary publicKey published)
      PairedOuter.GameWith.verdict PairedOuter.PaddedGame.checker publicKey result) := by
  rw [rest,simulateQ_bind,logged_source]
  apply bind_congr
  intro result
  exact publicProgram_source published _ (PairedOuter.PaddedGame.verdict_public _ _)

section Generic
variable {P : Type} [Fintype P] [SampleableType P] (S : FtsBankSpecL P)
  (pay : SigGolfCandidate.T3.Cache → Digest → HashOutput → M (Option SigGolfCandidate.Research.SharedForest.Signature))
  (hrecord : ∀ published request, Prod.fst <$> S.authenticatedRecord pay published request =
    PairedOuter.FullGame.authenticatedSign published request)

include hrecord

theorem bank_source (published : SigGolfCandidate.T3.Cache) : S.source pay published = source published := by
  funext input
  cases input with
  | inl input => rfl
  | inr request => exact hrecord published request

theorem recordedExperiment_eq (adversary : Final.Paired.AdversaryP) (budget : Nat) (hbudget : budget ≤ 2^127) :
    (fun r : PairedOuter.PaddedGame.TraceResult => (r.1,r.2.2)) <$>
        PairedOuter.PaddedGame.tracedExperiment adversary budget hbudget =
      S.recordedExperiment pay (rest adversary) := by
  change Prod.map id Prod.snd <$> PairedOuter.GameWith.Recorded.tracedExperiment
    PairedOuter.PaddedGame.checker adversary budget hbudget = _
  rw [PairedOuter.GameWith.Recorded.traced_source_erasure]
  unfold FtsBankSpecL.recordedExperiment PairedOuter.GameWith.idealGame
  rw [QueryRecorded.run_bind,liftM_bind]
  apply bind_congr
  intro generated
  rw [bank_source S pay hrecord,rest_source]

 theorem bank_traced (adversary : Final.Paired.AdversaryP) (budget : Nat) (hbudget : budget ≤ 2^127) :
    (fun r : Bool × ClaudeWCT.Bank.BankState SigGolfCandidate.Research.SharedForest.Signature => (r.1,r.2.2)) <$>
        S.bankExperiment pay (rest adversary) budget =
      (fun r : PairedOuter.PaddedGame.TraceResult => (r.1,r.2.2)) <$>
        PairedOuter.PaddedGame.tracedExperiment adversary budget hbudget :=
  (S.bank_experiment_project pay (rest adversary) budget).trans
    (recordedExperiment_eq S pay hrecord adversary budget hbudget).symm
end Generic
