      exact hx
    simp [hp]
theorem pmf_probEvent_or_le {α : Type} (p : PMF α) (F G : α → Prop) :
    Pr[fun x => F x ∨ G x | p] ≤ Pr[F | p] + Pr[G | p] := by
  simp only [probEvent_eq_tsum_ite]
  rw [← ENNReal.tsum_add]
  apply ENNReal.tsum_le_tsum
  intro x
  by_cases hF : F x <;> by_cases hG : G x <;> simp [hF, hG]
