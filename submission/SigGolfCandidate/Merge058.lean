open SigGolfCandidate.T3.Security.CreationGame (publicClass prefixCount prefixCount_prefix_mono prefixCount_append_singleton)
open SigGolfCandidate.T3.BPORS.Adaptive
open ClaudeWCT.W9.T3M
open ClaudeWCT.Bank (FtsBankSpecL birthWeight)
set_option maxHeartbeats 1000000
set_option maxRecDepth 10000
set_option backward.isDefEq.respectTransparency false
attribute [local instance] Classical.propDecidable

theorem source_birth_step (published : SigGolfCandidate.T3.Cache) (budget : Nat)
    (input : PairedOuter.LazyPrivate.Interaction.Domain)
    (before : QueryRecorded.State) (hcoherent : QueryRecorded.CostCoherent before)
    (result : PairedOuter.LazyPrivate.Interaction.Range input × QueryRecorded.State)
    (hr : result ∈ support (QueryRecorded.run (source published input) before)) :
    (prefixCount (publicClass CaseC.IsDigestInput) budget before.events : ENNReal) +
      birthWeight budget input before ≤
      (prefixCount (publicClass CaseC.IsDigestInput) budget result.2.events : ENNReal) := by
  have hmono := prefixCount_prefix_mono (publicClass CaseC.IsDigestInput) budget
    (QueryRecorded.run_events_extend _ before result hr)
  rcases input with (sample | input) | request
  · simpa only [birthWeight,add_zero] using (Nat.cast_le.mpr hmono : (_ : ENNReal) ≤ _)
  · by_cases hb : CaseC.Birth budget input before
    · rw [show birthWeight (Sig := SigGolfCandidate.Research.SharedForest.Signature) budget
        (.inl (.inr input)) before = 1 from if_pos hb]
      change result ∈ support
        (QueryRecorded.run (liftM (SigGolfCandidate.T3.Spec.query (.inl (.inr input)))) before) at hr
      rw [QueryRecorded.run_query_explicit,support_map] at hr
      obtain ⟨middle,_,rfl⟩ := hr
      change _ ≤ (prefixCount (publicClass CaseC.IsDigestInput) budget
        (before.events ++ [⟨before.base.source.2,.inl (.inr input),middle.1⟩]) : ENNReal)
      rw [prefixCount_append_singleton]
      · simp only [publicClass,hb.1,if_true,Nat.cast_add,Nat.cast_one,FullGame.queryCharge,Derivation.charged,Nat.cast_one,le_refl]
      · change (before.events.map (fun event => FullGame.queryCharge event.input)).sum + 1 ≤ budget
        rw [←hcoherent]
        exact hb.2.2
    · rw [show birthWeight (Sig := SigGolfCandidate.Research.SharedForest.Signature) budget
        (.inl (.inr input)) before = 0 from if_neg hb,add_zero]
      exact Nat.cast_le.mpr hmono
  · simpa only [birthWeight,add_zero] using (Nat.cast_le.mpr hmono : (_ : ENNReal) ≤ _)

section Generic
variable {P : Type} [Fintype P] [SampleableType P] (S : FtsBankSpecL P)
  (pay : SigGolfCandidate.T3.Cache → Digest → HashOutput → M (Option SigGolfCandidate.Research.SharedForest.Signature))
  (hrecord : ∀ published request, Prod.fst <$> S.authenticatedRecord pay published request =
    PairedOuter.FullGame.authenticatedSign published request)
include hrecord

theorem recordedImpl_run {α : Type} (published : SigGolfCandidate.T3.Cache)
    (program : OracleComp PairedOuter.LazyPrivate.Interaction α) (state : QueryRecorded.State) :
    (simulateQ (S.recordedImpl pay published) program).run state =
      (liftM (QueryRecorded.run (simulateQ (source published) program) state) : PMF _) := by
  induction program using OracleComp.inductionOn generalizing state with
  | pure value => simp only [simulateQ_pure,StateT.run_pure,QueryRecorded.run_pure,liftM_pure]
  | query_bind input next ih =>
      simp only [simulateQ_bind,simulateQ_spec_query,StateT.run_bind,FtsBankSpecL.recordedImpl,StateT.run_mk,
        bank_source S pay hrecord,QueryRecorded.run_bind,liftM_bind]
      apply bind_congr
      intro result
      exact ih result.1 result.2

 theorem source_expectedBirths_le_prefix {α : Type} (published : SigGolfCandidate.T3.Cache) (budget : Nat)
    (program : OracleComp PairedOuter.LazyPrivate.Interaction α) (state : QueryRecorded.State)
    (hinv : QueryRecorded.CostCoherent state) :
    (prefixCount (publicClass CaseC.IsDigestInput) budget state.events : ENNReal) +
      Creation.expectedCharges (S.recordedImpl pay published) (birthWeight budget) program state ≤
      expectedValue ((simulateQ (S.recordedImpl pay published) program).run state)
        (fun result => (prefixCount (publicClass CaseC.IsDigestInput) budget result.2.events : ENNReal)) := by
  induction program using OracleComp.inductionOn generalizing state with
  | pure value =>
      simp only [Creation.expectedCharges_pure,simulateQ_pure,StateT.run_pure,add_zero]
      rw [expectedValue_pure]
  | query_bind input next ih =>
      rw [Creation.expectedCharges_query_bind,←add_assoc]
      have hp := CaseC.pmf_expectedValue_mono ((S.recordedImpl pay published input).run state)
        (fun result hr => (add_le_add (source_birth_step published budget input state hinv result
          (by simpa only [FtsBankSpecL.recordedImpl,StateT.run_mk,bank_source S pay hrecord,
            MonitoredPrivate.pmf_support] using hr))
          (le_rfl : Creation.expectedCharges (S.recordedImpl pay published) (birthWeight budget) (next result.1) result.2 ≤ _)).trans
            (ih result.1 result.2 (QueryRecorded.run_cost_coherent (source published input) state hinv result
              (by simpa only [FtsBankSpecL.recordedImpl,StateT.run_mk,bank_source S pay hrecord,
                MonitoredPrivate.pmf_support] using hr))))
      rw [expectedValue_add,expectedValue_add,
        expectedValue_const (mx := ((S.recordedImpl pay published input).run state)) (by simp),
        expectedValue_const (mx := ((S.recordedImpl pay published input).run state)) (by simp)] at hp
      simpa only [simulateQ_bind,simulateQ_spec_query,StateT.run_bind,expectedValue_bind] using hp
end Generic
end ClaudeWCT.W9.T3.Security.PairedBankLink

