def rowCode (r : Nat) : List (BitVec 32) := (cTable.drop (6 * r)).take 6
theorem rowCode_img : ∀ r < 128, (Images.expandCode_172.drop (44193 + 6 * r - 44032)).take 6 = rowCode r := by
  decide +kernel
theorem rowCode_length (r : Nat) (hr : r < 128) : (rowCode r).length = 6 := by
  unfold rowCode; rw [List.length_take, List.length_drop, show cTable.length = 768 from rfl]; omega
theorem code_row (r : Nat) (hr : r < 128) : CodeAt Images.expandImage (pcOf (44193 + 6 * r)) (rowCode r) :=
  code_last (by omega) (by rw [rowCode_length r hr]; omega) (by rw [rowCode_length r hr]; exact rowCode_img r hr)

def rowRegs (r : Nat) : RegFile :=
  ((((RegFile.init.set .x11 (.c (BitVec.ofNat 64 (offR r 0)))).set .x12 (.c (BitVec.ofNat 64 (offR r 1)))).set .x13
    (.c (BitVec.ofNat 64 (offR r 2)))).set .x15 (.c (BitVec.ofNat 64 (offR r 3)))).set .x16
    (.c (BitVec.ofNat 64 (offR r 4)))
def rowRes (r : Nat) : Result :=
  ⟨⟨rowRegs r, [], []⟩, .c (pcOf (if r < 64 then 44974 else 45000)), .jump, 6, 6⟩
theorem run_row (r : Nat) (hr : r < 128) :
    symRun cfgW (rowCode r) (pcOf (44193 + 6 * r)) 10 = some (rowRes r) := by
  interval_cases r <;> kernel_rfl

theorem row_spec (r : Nat) (hr : r < 128) (v : MachineState) (hpc : v.pc = pcOf (44193 + 6 * r)) :
    ∃ w, Steps Images.expandImage v 6 6 w ∧ w.pc = pcOf (if r < 64 then 44974 else 45000) ∧
      w.getReg .x11 = BitVec.ofNat 64 (offR r 0) ∧ w.getReg .x12 = BitVec.ofNat 64 (offR r 1) ∧
      w.getReg .x13 = BitVec.ofNat 64 (offR r 2) ∧ w.getReg .x15 = BitVec.ofNat 64 (offR r 3) ∧
      w.getReg .x16 = BitVec.ofNat 64 (offR r 4) ∧
      RegsExcept v w [.x11, .x12, .x13, .x15, .x16] ∧ ∀ A, w.getMem A = v.getMem A := by
  refine ⟨_, symRun_sound (run_row r hr) (code_row r hr) v hpc trivial, rfl, rfl, rfl, rfl, rfl, rfl, ?_,
    fun A => rfl⟩
  intro x hx
  rw [Result.toState_getReg]
  cases x <;> first | rfl | (exfalso; simp at hx)

/-! ### Dispatch targets -/
theorem and63 (L : Word) : L &&& 63#64 = BitVec.ofNat 64 (L.toNat % 64) := by
  apply BitVec.eq_of_toNat_eq
  rw [BitVec.toNat_and, BitVec.toNat_ofNat, BitVec.toNat_ofNat]
  have : (63 % 2 ^ 64 : Nat) = 2 ^ 6 - 1 := by norm_num
  rw [this, Nat.and_two_pow_sub_one_eq_mod]
  omega
theorem srl6 (L : Word) : (L >>> 6).toNat % 64 = L.toNat / 64 % 64 := by
  rw [BitVec.toNat_ushiftRight, Nat.shiftRight_eq_div_pow]
def gT (c : Nat) (a : Word) : Word := ((a <<< 3 + a <<< 4) + BitVec.ofNat 64 c) &&& ~~~1#64
theorem gA_eq : ∀ r < 64, gT 180868 (BitVec.ofNat 64 r) = pcOf (44193 + 6 * r) := by decide +kernel
theorem gB_eq : ∀ r < 64, gT 182404 (BitVec.ofNat 64 r) = pcOf (44193 + 6 * (64 + r)) := by decide +kernel

/-! ### The three straight blocks -/
def nonceAddr (k : Nat) : Word := BitVec.ofNat 64 (0x66700 + 8 * k)
/-- Single-dword update. -/
def upd (M : Word → Word) (a : Nat) (v : Word) : Word → Word := fun A => if A = BitVec.ofNat 64 a then v else M A

theorem p1_spec (s : MachineState) (hpc : s.pc = pcOf 44961) :
    ∃ u, Steps Images.expandImage s 13 13 u ∧
      u.pc = pcOf (44193 + 6 * ((s.getMem (BitVec.ofNat 64 0x66758)).toNat % 64)) ∧
      u.getReg .x28 = BitVec.ofNat 64 0x66700 ∧ u.getReg .x29 = s.getMem (BitVec.ofNat 64 0x66758) ∧
      u.getReg .x30 = BitVec.ofNat 64 11792 ∧
      RegsExcept s u [.x14, .x17, .x28, .x29, .x30] ∧ ∀ A, u.getMem A = s.getMem A := by
  refine ⟨_, symRun_sound eP1 code_P1 s hpc trivial, ?_, rfl, rfl, rfl, ?_, fun A => rfl⟩
  · rw [Result.toState_pc]
    show gT 180868 (s.getMem (BitVec.ofNat 64 0x66758) &&& 63#64) = _
    rw [and63, gA_eq _ (Nat.mod_lt _ (by decide))]
  · intro x hx
    cases x <;> first | (exfalso; simp at hx; done) | (simp only [rv_simp, eP1.res]; done) | rfl

theorem bnd (a : Nat) (h : a ≤ 640) : a + 11792 < 2 ^ 64 := by omega

theorem s1_spec (u : MachineState) (hpc : u.pc = pcOf 44974) (a1 a2 a3 a5 a6 : Nat)
    (b1 : a1 % 8 = 0 ∧ a1 ≤ 640) (b2 : a2 % 8 = 0 ∧ a2 ≤ 640) (b3 : a3 % 8 = 0 ∧ a3 ≤ 640)
    (b5 : a5 % 8 = 0 ∧ a5 ≤ 640) (b6 : a6 % 8 = 0 ∧ a6 ≤ 640) (L : Word)
    (h11 : u.getReg .x11 = BitVec.ofNat 64 a1) (h12 : u.getReg .x12 = BitVec.ofNat 64 a2)
    (h13 : u.getReg .x13 = BitVec.ofNat 64 a3) (h15 : u.getReg .x15 = BitVec.ofNat 64 a5)
    (h16 : u.getReg .x16 = BitVec.ofNat 64 a6) (h28 : u.getReg .x28 = BitVec.ofNat 64 0x66700)
    (h29 : u.getReg .x29 = L) (h30 : u.getReg .x30 = BitVec.ofNat 64 11792) :
    ∃ v, Steps Images.expandImage u 26 26 v ∧ v.pc = pcOf (44193 + 6 * (64 + L.toNat / 64 % 64)) ∧
      v.getReg .x28 = BitVec.ofNat 64 0x66700 ∧ v.getReg .x30 = BitVec.ofNat 64 11792 ∧
      RegsExcept u v [.x6, .x11, .x12, .x13, .x14, .x15, .x16, .x17] ∧
      ∀ A, v.getMem A = upd (upd (upd (upd (upd (upd u.getMem (a1 + 11792) (u.getMem (nonceAddr 0)))
        (a2 + 11792) (u.getMem (nonceAddr 1))) (a3 + 11792) (u.getMem (nonceAddr 2)))
        (a5 + 11792) (u.getMem (nonceAddr 3))) (a6 + 11792) (u.getMem (nonceAddr 4)))
        (11792 + 368) (u.getMem (nonceAddr 5)) A := by
  refine ⟨_, symRun_sound eS1 code_S1 u hpc ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simp only [rv_simp, accessValid_iff, MEMORY_BYTES, ne_eq, BitVec.toNat_eq, BitVec.toNat_add, BitVec.toNat_sub,
      BitVec.toNat_ofNat, eS1.res, h11, h12, h13, h15, h16, h28, h30] <;> (try and_intros) <;> first | trivial | omega
  · rw [Result.toState_pc]
    show gT 182404 ((u.getReg .x29 >>> 6) &&& 63#64) = _
    rw [and63, srl6, h29, gB_eq _ (Nat.mod_lt _ (by decide))]
  · exact h28
  · exact h30
  · intro x hx
    cases x <;> first | (exfalso; simp at hx; done) | (simp only [rv_simp, eS1.res]; done) | rfl
  · intro A
    simp only [Result.toState_getMem, eS1.res, memEval_cons, memEval_nil, Addr.eval, E.eval, BinOp.eval,
      RegFile.get, h11, h12, h13, h15, h16, h28, h30, BitVec.add_zero, BitVec.ofNat_add_ofNat, upd, nonceAddr]

theorem s2_spec (u : MachineState) (hpc : u.pc = pcOf 45000) (a1 a2 a3 a5 a6 : Nat)
    (b1 : a1 % 8 = 0 ∧ a1 ≤ 640) (b2 : a2 % 8 = 0 ∧ a2 ≤ 640) (b3 : a3 % 8 = 0 ∧ a3 ≤ 640)
    (b5 : a5 % 8 = 0 ∧ a5 ≤ 640) (b6 : a6 % 8 = 0 ∧ a6 ≤ 640)
    (h11 : u.getReg .x11 = BitVec.ofNat 64 a1) (h12 : u.getReg .x12 = BitVec.ofNat 64 a2)
    (h13 : u.getReg .x13 = BitVec.ofNat 64 a3) (h15 : u.getReg .x15 = BitVec.ofNat 64 a5)
    (h16 : u.getReg .x16 = BitVec.ofNat 64 a6) (h28 : u.getReg .x28 = BitVec.ofNat 64 0x66700)
    (h30 : u.getReg .x30 = BitVec.ofNat 64 11792) :
    ∃ v, Steps Images.expandImage u 16 16 v ∧ v.pc = pcOf 45016 ∧ v.getReg .x10 = 0 ∧
      RegsExcept u v [.x6, .x10, .x11, .x12, .x13, .x15, .x16] ∧
      ∀ A, v.getMem A = upd (upd (upd (upd (upd u.getMem (a1 + 11792) (u.getMem (nonceAddr 6)))
        (a2 + 11792) (u.getMem (nonceAddr 7))) (a3 + 11792) (u.getMem (nonceAddr 8)))
        (a5 + 11792) (u.getMem (nonceAddr 9))) (a6 + 11792) (u.getMem (nonceAddr 10)) A := by
  refine ⟨_, symRun_sound eS2 code_S2 u hpc ?_, rfl, rfl, ?_, ?_⟩
  · simp only [rv_simp, accessValid_iff, MEMORY_BYTES, ne_eq, BitVec.toNat_eq, BitVec.toNat_add, BitVec.toNat_sub,
      BitVec.toNat_ofNat, eS2.res, h11, h12, h13, h15, h16, h28, h30] <;> (try and_intros) <;> first | trivial | omega
  · intro x hx
    rw [Result.toState_getReg]
    cases x <;> first | rfl | (exfalso; simp at hx)
  · intro A
    simp only [Result.toState_getMem, eS2.res, memEval_cons, memEval_nil, Addr.eval, E.eval, BinOp.eval,
      RegFile.get, h11, h12, h13, h15, h16, h28, h30, BitVec.add_zero, BitVec.ofNat_add_ofNat, upd, nonceAddr]

/-! ### The pad writer -/
/-- The leaf word saved at `0x66758`; rows `A = leaf % 64`, `B = leaf / 64 % 64`. -/
def leafW (M : Word → Word) : Nat := (M (BitVec.ofNat 64 0x66758)).toNat
/-- Memory after the pad writer: eleven dword stores at `0x2e10 + offset` of the nonces `mem[0x66700 + 8 k]`. -/
def padMem (M : Word → Word) : Word → Word :=
  let rA := leafW M % 64
  let rB := leafW M / 64 % 64
  upd (upd (upd (upd (upd (upd (upd (upd (upd (upd (upd M
    (offA rA 0 + 11792) (M (nonceAddr 0))) (offA rA 1 + 11792) (M (nonceAddr 1)))
    (offA rA 2 + 11792) (M (nonceAddr 2))) (offA rA 3 + 11792) (M (nonceAddr 3)))
    (offA rA 4 + 11792) (M (nonceAddr 4))) (11792 + 368) (M (nonceAddr 5)))
    (offB rB 0 + 11792) (M (nonceAddr 6))) (offB rB 1 + 11792) (M (nonceAddr 7)))
    (offB rB 2 + 11792) (M (nonceAddr 8))) (offB rB 3 + 11792) (M (nonceAddr 9)))
    (offB rB 4 + 11792) (M (nonceAddr 10))

theorem upd_ne (M : Word → Word) (a : Nat) (v : Word) (A : Nat) (ha : a < 2 ^ 64) (hA : A < 2 ^ 64) (h : A ≠ a) :
    upd M a v (BitVec.ofNat 64 A) = M (BitVec.ofNat 64 A) := by
  unfold upd
  rw [if_neg]
  intro e
  apply h
  have := congrArg BitVec.toNat e
  rwa [BitVec.toNat_ofNat, BitVec.toNat_ofNat, Nat.mod_eq_of_lt ha, Nat.mod_eq_of_lt hA] at this

theorem upd_nonce (M : Word → Word) (a : Nat) (v : Word) (k : Nat) (ha : a ≤ 13000) (hk : k < 11) :
    upd M a v (nonceAddr k) = M (nonceAddr k) := by
  unfold upd nonceAddr
  rw [if_neg]
  intro e
  have := congrArg BitVec.toNat e
  rw [BitVec.toNat_ofNat, BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)] at this
  omega

/-- The pad writer: from `44961`, 67 steps to the `ecall` at `45016` with `a0 = 0`. -/
theorem pad_spec (s : MachineState) (hpc : s.pc = pcOf 44961) :
    ∃ t, Steps Images.expandImage s 67 67 t ∧ t.pc = pcOf 45016 ∧ t.getReg .x10 = 0 ∧
      RegsExcept s t [.x6, .x10, .x11, .x12, .x13, .x14, .x15, .x16, .x17, .x28, .x29, .x30] ∧
      ∀ A, t.getMem A = padMem s.getMem A := by
  obtain ⟨u, su, up, u28, u29, u30, ru, mu⟩ := p1_spec s hpc
  have hA : leafW s.getMem % 64 < 128 := by omega
  obtain ⟨v, sv, vp, v11, v12, v13, v15, v16, rv, mv⟩ := row_spec _ hA u up
  rw [if_pos (Nat.mod_lt _ (by decide))] at vp
  have bA := fun i (hi : i < 5) => offR_bounds _ hA i hi
  have rv' := ru.trans rv
  obtain ⟨w, sw, wp, w28, w30, rw', mw⟩ := s1_spec v vp _ _ _ _ _
    ⟨(bA 0 (by decide)).1, (bA 0 (by decide)).2.2⟩ ⟨(bA 1 (by decide)).1, (bA 1 (by decide)).2.2⟩
    ⟨(bA 2 (by decide)).1, (bA 2 (by decide)).2.2⟩ ⟨(bA 3 (by decide)).1, (bA 3 (by decide)).2.2⟩
    ⟨(bA 4 (by decide)).1, (bA 4 (by decide)).2.2⟩ (s.getMem (BitVec.ofNat 64 0x66758))
    v11 v12 v13 v15 v16
    (by rw [rv .x28 (by simp)]; exact u28) (by rw [rv .x29 (by simp)]; exact u29)
    (by rw [rv .x30 (by simp)]; exact u30)
  have hB : 64 + leafW s.getMem / 64 % 64 < 128 := by omega
  obtain ⟨x, sx, xp, x11, x12, x13, x15, x16, rx, mx⟩ := row_spec _ hB w wp
  rw [if_neg (by omega)] at xp
  have bB := fun i (hi : i < 5) => offR_bounds _ hB i hi
  obtain ⟨t, st, tp, t10, rt, mt⟩ := s2_spec x xp _ _ _ _ _
    ⟨(bB 0 (by decide)).1, (bB 0 (by decide)).2.2⟩ ⟨(bB 1 (by decide)).1, (bB 1 (by decide)).2.2⟩
    ⟨(bB 2 (by decide)).1, (bB 2 (by decide)).2.2⟩ ⟨(bB 3 (by decide)).1, (bB 3 (by decide)).2.2⟩
    ⟨(bB 4 (by decide)).1, (bB 4 (by decide)).2.2⟩
    x11 x12 x13 x15 x16 (by rw [rx .x28 (by simp)]; exact w28) (by rw [rx .x30 (by simp)]; exact w30)
  refine ⟨t, Steps.of_eq (su.trans (sv.trans (sw.trans (sx.trans st)))) rfl rfl, tp, t10, ?_, ?_⟩
  · exact (((ru.trans rv).trans rw').trans (rx.trans rt)).mono (by simp)
  · intro A
    have hx' : x.getMem = w.getMem := funext mx
    have hv : ∀ B, v.getMem B = s.getMem B := fun B => (mv B).trans (mu B)
    have hv' : v.getMem = s.getMem := funext hv
    have b0 := (offR_bounds _ hA 0 (by decide)).2.2
    have b1 := (offR_bounds _ hA 1 (by decide)).2.2
    have b2 := (offR_bounds _ hA 2 (by decide)).2.2
    have b3 := (offR_bounds _ hA 3 (by decide)).2.2
    have b4 := (offR_bounds _ hA 4 (by decide)).2.2
    have hn : ∀ k, k < 11 → w.getMem (nonceAddr k) = s.getMem (nonceAddr k) := by
      intro k hk
      rw [mw, upd_nonce _ _ _ _ (by omega) hk, upd_nonce _ _ _ _ (by omega) hk, upd_nonce _ _ _ _ (by omega) hk,
        upd_nonce _ _ _ _ (by omega) hk, upd_nonce _ _ _ _ (by omega) hk, upd_nonce _ _ _ _ (by omega) hk, hv]
    have hw : w.getMem = upd (upd (upd (upd (upd (upd s.getMem (offA (leafW s.getMem % 64) 0 + 11792)
        (s.getMem (nonceAddr 0))) (offA (leafW s.getMem % 64) 1 + 11792) (s.getMem (nonceAddr 1)))
        (offA (leafW s.getMem % 64) 2 + 11792) (s.getMem (nonceAddr 2)))
        (offA (leafW s.getMem % 64) 3 + 11792) (s.getMem (nonceAddr 3)))
        (offA (leafW s.getMem % 64) 4 + 11792) (s.getMem (nonceAddr 4))) (11792 + 368)
        (s.getMem (nonceAddr 5)) := by
      funext B
      rw [mw, hv']
      rfl
    rw [mt, hx', hn 6 (by decide), hn 7 (by decide), hn 8 (by decide), hn 9 (by decide), hn 10 (by decide), hw]
    rfl

theorem pad_hook (s : MachineState) (hpc : s.pc = pcOf 54174) :
    ∃ t, Steps Images.expandImage s 68 68 t ∧ t.pc = pcOf 45016 ∧ t.getReg .x10 = 0 ∧
      RegsExcept s t [.x6, .x10, .x11, .x12, .x13, .x14, .x15, .x16, .x17, .x28, .x29, .x30] ∧
      ∀ A, t.getMem A = padMem s.getMem A := by
  have s1 := symRun_sound eHook code_hook s hpc trivial
  obtain ⟨t, st, tp, t10, rt, mt⟩ := pad_spec (eHook.res.toState s) (by simp only [rv_simp, eHook.res] <;> decide)
  refine ⟨t, Steps.of_eq (s1.trans st) rfl rfl, tp, t10, ?_, fun A => (mt A).trans ?_⟩
  · intro r hr
    rw [rt r hr]
    cases r <;> first | (simp only [rv_simp, eHook.res]; done) | rfl
  · rfl


end ClaudeWCT.W9.Machine.Expand.PadWriter
