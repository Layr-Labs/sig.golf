theorem split_unique (adversary : Final.Paired.AdversaryP) (result : FirstHit.Recorded Bool)
    (gen0 : FirstHit.Recorded (Digest × SigGolfCandidate.T3.Cache))
    (hg0 : gen0 ∈ support (FirstHit.record keygen (∅, ∅)))
    (int0 : FirstHit.Recorded (Option Final.Paired.ForgeryP × QueryLog Final.Paired.Requests))
    (hi0 : int0 ∈ support (FirstHit.record (PairedOuter.FullGame.loggedWith (PairedOuter.FullGame.authenticatedSign gen0.value.2)
      (adversary gen0.value.1 gen0.value.2)) gen0.state))
    (rest : List FirstHit.QueryEvent) (hev : result.events = gen0.events ++ (int0.events ++ rest))
    (generated : FirstHit.Recorded (Digest × SigGolfCandidate.T3.Cache))
    (interaction : FirstHit.Recorded (Option Final.Paired.ForgeryP × QueryLog Final.Paired.Requests)) (checked : FirstHit.Recorded Bool)
    (hsplit : Wots.PairedReference.GameSplit adversary result generated interaction checked) :
    generated = gen0 ∧ interaction = int0 := by
  obtain ⟨hg, hi, _, hres⟩ := hsplit
  have hev' : result.events = generated.events ++ (interaction.events ++ checked.events) := by rw [hres]
  have hgen : generated = gen0 :=
    record_prefix_unique keygen (∅, ∅) generated gen0 hg hg0 _ _ (hev'.symm.trans hev)
  subst hgen
  have hcut : interaction.events ++ checked.events = int0.events ++ rest :=
    List.append_cancel_left (hev'.symm.trans hev)
  exact ⟨rfl, record_prefix_unique _ _ interaction int0 hi hi0 _ _ hcut⟩
include hrecord in
theorem bank_actual (hhash : ClaudeWCT.Bank.PayHashOnly pay) (hrho : ClaudeWCT.Bank.PayRho pay sigRho)
    (hAvoids : ClaudeWCT.Bank.PayAvoids pay) (adversary : Final.Paired.AdversaryP) (budget : Nat) (b : Bool × PairedBankState)
    (hb : b ∈ (S.bankExperiment pay (rest adversary) budget).support) :
    ∃ generated ∈ support (QueryRecorded.run keygen QueryRecorded.initial),
      ∃ int0 : FirstHit.Recorded (Option Final.Paired.ForgeryP × QueryLog Final.Paired.Requests),
        int0 ∈ support (FirstHit.record (PairedOuter.FullGame.loggedWith (PairedOuter.FullGame.authenticatedSign generated.1.2)
          (adversary generated.1.1 generated.1.2)) (lazyOf generated.2)) ∧
        (∃ rest, b.2.2.events = generated.2.events ++ (int0.events ++ rest)) ∧
        b.2.1.log = int0.value.2 ∧ S.BankInv pay sigRho generated.1.2 budget generated.2.events b.2 := by
  unfold FtsBankSpecL.bankExperiment at hb
  change b ∈ (PMF.bind _ _).support at hb
  rw [PMF.mem_support_bind_iff] at hb
  obtain ⟨generated, hg, hb⟩ := hb
  rw [MonitoredPrivate.pmf_support] at hg
  refine ⟨generated, hg, ?_⟩
  have hinv := S.bankInv_run pay sigRho hhash hrho hAvoids generated.1.2 budget generated.2.events _ (Ghost.empty, generated.2)
    (S.bankInv_initial pay sigRho generated.1.2 budget generated hg) b hb
  unfold rest at hb
  rw [simulateQ_bind, StateT.run_bind] at hb
  change b ∈ (PMF.bind _ _).support at hb
  rw [PMF.mem_support_bind_iff] at hb
  obtain ⟨i, hi, hb⟩ := hb
  have hproj := S.bank_project pay generated.1.2 budget (PairedOuter.ProposalOverflow.logged (adversary generated.1.1 generated.1.2))
    (Ghost.empty, generated.2)
  have hi' : (i.1, i.2.2) ∈ support (QueryRecorded.run (PairedOuter.FullGame.loggedWith (PairedOuter.FullGame.authenticatedSign generated.1.2)
      (adversary generated.1.1 generated.1.2)) generated.2) := by
    have hm : Prod.map id Prod.snd i ∈ (Prod.map id Prod.snd <$>
        (simulateQ (S.bankImpl pay generated.1.2 budget)
          (PairedOuter.ProposalOverflow.logged (adversary generated.1.1 generated.1.2))).run (Ghost.empty, generated.2)).support := by
      rw [PMF.monad_map_eq_map, PMF.mem_support_map_iff]
      exact ⟨i, hi, rfl⟩
    rw [hproj, MonitoredPrivate.pmf_support, bank_source S pay hrecord, logged_source] at hm
    exact hm
  obtain ⟨int0, hint0, hev0, hstate0, hvalue0⟩ := recorded_new_events _ generated.2 _ hi'
  have hprojv := S.bank_project pay generated.1.2 budget
    (publicProgram (PairedOuter.GameWith.verdict PairedOuter.PaddedGame.checker generated.1.1 i.1)) i.2
  have hb' : (b.1, b.2.2) ∈ support (QueryRecorded.run (simulateQ (source generated.1.2)
      (publicProgram (PairedOuter.GameWith.verdict PairedOuter.PaddedGame.checker generated.1.1 i.1))) i.2.2) := by
    have hm : Prod.map id Prod.snd b ∈ (Prod.map id Prod.snd <$>
        (simulateQ (S.bankImpl pay generated.1.2 budget)
          (publicProgram (PairedOuter.GameWith.verdict PairedOuter.PaddedGame.checker generated.1.1 i.1))).run i.2).support := by
      rw [PMF.monad_map_eq_map, PMF.mem_support_map_iff]
      exact ⟨b, hb, rfl⟩
    rw [hprojv, MonitoredPrivate.pmf_support, bank_source S pay hrecord] at hm
    exact hm
  obtain ⟨more, hmore⟩ := QueryRecorded.run_events_extend _ i.2.2 (b.1, b.2.2) hb'
  refine ⟨int0, hint0, ⟨more, ?_⟩, ?_, hinv⟩
  · rw [← hmore, hev0, List.append_assoc]
  · rw [public_ghost_log S pay generated.1.2 budget _ i.2 b hb,
      logged_ghost_log S pay generated.1.2 budget _ (Ghost.empty, generated.2) i hi, hvalue0]
    simp [Ghost.empty]

