      · have hdec := kAcc_decode hacc2
        have hpdo : WCT9.CanonicalPolicy.producerDecodeOut 0 (14+extra) a =
            some (T3.dataDigits 0 (a.extractLsb' 128 128) ++ [152 - LW (a.extractLsb' 128 128)], false) := by
