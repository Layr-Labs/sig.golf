      RegsExcept s t [] ∧ Frame s t (fun _ => False) := by
  have hs := symRun_sound (runCapJ b k hK.2.1 hk) (codeAt_capHelperJump hK k hk) s hpc
    (by simp [rv_simp])
  refine ⟨_, hs, ?_, ?_, ?_⟩
  · simp [Result.toState_pc, E.eval]
