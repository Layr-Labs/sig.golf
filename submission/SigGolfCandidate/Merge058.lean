  obtain ⟨h, h1, h2, h3, h4, h5, _⟩ := kLanes v hr7; omega
theorem kSum_W (v : Digest) (hr7 : 79 ≤ v.toNat / 2 ^ 56 % 128) : (kS9 v + kPen v) / 2 ^ 22 = LW v := by
  obtain ⟨h, h1, h2, h3, h4, h5, _⟩ := kLanes v hr7; omega
