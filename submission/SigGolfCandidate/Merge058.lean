    (hr : fixedRun (envE D Nn) g (Guess.discloseQ (auxSpec := AuxSpecL) c) s r ≠ 0) : r.2.memory = s.memory := by
  have h := Guess.fixedRun_discloseQ (envE D Nn) g c s r hr
