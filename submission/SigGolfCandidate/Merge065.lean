    · rw [show TAG + 8 * 1 = TAG + 8 from rfl, g8]; exact this
    · rw [show TAG + 8 * 2 = TAG + 16 from rfl, g16]; exact this
    · rw [show TAG + 8 * 3 = TAG + 24 from rfl, g24]; exact this
