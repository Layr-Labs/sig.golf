  set t5 := writeHash t4 b
  have hwf5 := Frame.writeHash t4 b RHOOUT y12 (by decide)
  have hrho : DigAt t5 RHOOUT (b.extractLsb' 0 128) := DigAt.writeHash_lo t4 b RHOOUT y12 (by decide)
