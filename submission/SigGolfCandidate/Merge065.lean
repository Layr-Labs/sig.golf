    rw [f3.get (by sg_omega) (fun h => h), hwf.get (by sg_omega) (by sg_omega), e1 _ (by sg_omega) (by sg_omega)]
    exact sinit_msg sk cache m j hj
  have x5' : t4.getReg .x5 = 0 := by
    rw [r4.get (by decide), r3.get (by decide), t2x5]
