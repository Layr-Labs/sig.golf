  intro vs t ht
  exact ⟨ht.1,ht.2.1,ht.2.2.1,(ur.trans ht.2.2.2.1).mono (by simp [SigGolfCandidate.T3M.Keygen.chainRegs]),
    (uf.trans ht.2.2.2.2.1).mono (by simp), fun hF he0 => ht.2.2.2.2.2 hF (Or.inr he0)⟩

