        ⟨Or.inl tp,t5,t10,tfetch⟩)).mono (by unfold suffixW; omega) (fun _ _ h=>h)
    · exact (TBSim.pure (Q:=ClaudeWCT.W9.Machine.ExpandLink.PairedExpPost) (a:=none)
        ⟨Or.inl hp,h5,h10,hfetch⟩).mono (by unfold suffixW; omega) (fun _ _ h=>h)
