    (((f1.trans hwf).trans f3).trans f4).mono (fun X _ h => by
      rcases h with ((h | h) | h) | h
      · exact Or.inl h
      · sg_omega
      · exact h.elim
      · sg_omega)
  have k : ∀ j < 4, t3.getMem (BitVec.ofNat 64 (SK + 8 * j)) = sk.extractLsb' (64 * j) 64 := fun j hj => by
