  · simp only [Result.toState_getMem, prefix_copy.res]
    t3n [h8, h19, h20, buffer]
    rw [if_pos (by omega)]
  · intro r hr; simp at hr; cases r <;> simp_all [prefix_copy.res, rv_simp] <;> rfl
  · intro A hA hn
    simp only [Result.toState_getMem, prefix_copy.res]
    t3n [h8, h19, h20, buffer]
    simp only [buffer] at hn
    rw [if_neg (by omega), if_neg (by omega)]
