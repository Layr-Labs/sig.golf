  have ht0 : 0≤t := div_nonneg (sub_nonneg.mpr hy0) (by norm_num)
  have ht1 : t≤1 := (div_le_one (by norm_num : (0:ℝ)<1/2-2163/1000000)).2 (by linarith)
  have h := price_excess_affine (2^32) (2-4326/1000000-939/80000) (1-939/80000)
    (107200443/50000000000) (49/100) t (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    ht0 ht1 excess_high_certified excess_low_certified
  have harg : (1-t)*(2-4326/1000000-939/80000)+t*(1-939/80000) = 2-2*y-939/80000 := by
    dsimp [t]; ring
  rw [harg] at h
  have hgap : (49561/50000)*y-((1-t)*(107200443/50000000000)+t*(49/100)) = t*(561/100000) := by
    dsimp [t]; ring
  have hval : (1-t)*(107200443/50000000000)+t*(49/100) ≤ (49561/50000)*y := by nlinarith
  exact h.trans (ENNReal.ofReal_le_ofReal hval)

