    (ENNReal.ofReal_le_ofReal (by norm_num : (397071 : ℝ) / 200000 - 939 / 80000 ≤ 249 / 125 - 939 / 80000)) _)).trans
    (excess_middle_certified.trans (ENNReal.ofReal_le_ofReal (by norm_num)))
