    (s : MachineState) (hp : s.pc=pcOf 22124) :
    ∃ t, Steps im s 4 4 t ∧ t.pc=pcOf 22128 ∧ t.getReg .x8=1 ∧ t.getMem (0x66000#64)=0 ∧
