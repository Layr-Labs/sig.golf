theorem steps {im : Image} (hc : Code im)
    (s : MachineState) (hp : s.pc=pcOf 22182) (index : Nat) (hi : index<2^31)
    (hidx : s.getMem 0x20550=BitVec.ofNat 64 index) (left right : Digest)
