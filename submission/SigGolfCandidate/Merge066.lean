theorem copy22107_steps {im : Image} (hc : CodeAt im (pcOf 22107) copy22107Code)
    (s : MachineState) (hp : s.pc=pcOf 22107) (dest : Nat) (ha : 0x66000≤dest) (hb : dest+32≤0x66200) (ha8 : dest%8=0)
