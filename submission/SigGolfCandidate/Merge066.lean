structure Code (im : Image) : Prop where
  at22128 : CodeAt im (pcOf 22128) code22128
  at22138 : CodeAt im (pcOf 22138) code22138
  at22143 : CodeAt im (pcOf 22143) code22143
  at22145 : CodeAt im (pcOf 22145) code22145
