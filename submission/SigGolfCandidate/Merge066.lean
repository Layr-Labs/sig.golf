theorem finish_steps {im : Image} (hc : CodeAt im (pcOf 22526) finishWords)
    (s : MachineState) (hp : s.pc=pcOf 22526)
    (h28 : s.getReg .x28=BitVec.ofNat 64 (SIG+16*328))
    (h29 : s.getReg .x29=BitVec.ofNat 64 (SIG+16*324)) :
