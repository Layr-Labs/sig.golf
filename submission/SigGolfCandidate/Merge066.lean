theorem steps {im : Image} (hc : CodeAt im (pcOf 24661) code)
    (s : MachineState) (hp : s.pc=pcOf 24661) (flag : Nat) (hf : CfTableOK flag s) :
    ∃ t,Steps im s 4 4 t ∧ t.pc=pcOf 22100 ∧ CfTableOK 0 t ∧
