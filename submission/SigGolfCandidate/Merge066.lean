  have hn0 := hnode (2*cur.length) (by omega)
  have hn1 := hnode (2*cur.length+1) (by omega)
  have rw2 : RegsExcept t (writeHash t2 a) [.x6, .x7, .x10, .x11, .x12, .x28] := fun r hr => by
