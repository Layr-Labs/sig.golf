    (by rw [ur.get (by simp [tRegs, leafRegs]), r12.get (by decide)]; exact ht.x18)
  refine TSim.pure_steps st3 ⟨t3pc, t3x18, ?_, ?_, by simp [ht.len], ?_, ?_⟩
