  x17 : t.getReg .x17=152
  x18 : t.getReg .x18=BitVec.ofNat 64 (index/2^19)
  x26 : t.getReg .x26=51
  x27 : t.getReg .x27=51
  x28 : t.getReg .x28=BitVec.ofNat 64 ENC
  x29 : t.getReg .x29=BitVec.ofNat 64 0x66040
