      simp [block.res,rv_simp,TOP_DATA] at old ⊢ <;> try exact old
    all_goals first
      | exact extractByte_replaceByte_same _ _ (by decide) _
      | rw [extractByte_replaceByte_diff _ _ _ (by decide) (by decide) (by decide)];exact old
