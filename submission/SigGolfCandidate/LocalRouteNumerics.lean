theorem index_initial_sum : (∑ i : Fin (2^31), indexInitial i.val) ≤ 2^31*meanInitial := by
  unfold indexInitial
  rw [LocalRouteUniform.index_uniform]
  calc
    2^26 * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2, ∑ e : Fin 2,
        initialF (a.val+b.val) c.val d.val e.val) ≤ 2^26 * (32*meanInitial) :=
      Nat.mul_le_mul_left _ thirtytwo_checked
    _ = 2^31*meanInitial := by ring
