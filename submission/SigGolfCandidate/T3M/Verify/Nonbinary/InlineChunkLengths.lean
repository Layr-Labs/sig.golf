theorem chunk_count : originalChunks.length = 985 := by
  have h := congrArg List.length lengths
  simpa only [List.length_map, List.length_append, List.length_replicate,
    List.length_cons, List.length_nil] using h

theorem originalChunks_ok : (originalChunks.dropLast.all fun c => c.length == 256) = true := by
  change (originalChunks.dropLast.all ((fun n : Nat => n == 256) ∘ List.length)) = true
  rw [← List.all_map, List.map_dropLast, lengths]
  decide +kernel

theorem originalChunks_le : (originalChunks.all fun c => decide (c.length ≤ 256)) = true := by
  change (originalChunks.all ((fun n : Nat => decide (n ≤ 256)) ∘ List.length)) = true
  rw [← List.all_map, lengths]
  decide +kernel

theorem flatten_length : originalChunks.flatten.length = 251927 := by
  rw [List.length_flatten, lengths]
