theorem full_chunk_length (j : Nat) (hj : j < 984) :
    (originalChunks.getD j []).length = 256 := by
  rw [← List.getD_map (l := originalChunks) (d := []) (n := j) List.length,
    lengths, List.getD_append _ _ _ _ (by simpa only [List.length_replicate] using hj)]
