      (K : List (BitVec 256) → M β) (Kv : Digest → M β),
    s + r = digits.getD t 0 → as.length = (digits.take t).sum + s →
    v = stepValue w k digits t s as →
    (∀ new : List (BitVec 256), new.length = r →
