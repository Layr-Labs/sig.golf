/-- Deficit word of rank `r` (T8E N563fix code, lexicographic = rank order). -/
def codewordL (r : Nat) : List Nat := WCT9.codeWords.getD r []
def routineCost : Nat := 300
def routineOK (r : Nat) : Bool :=
  match walk (codewordL r) 64 0 (routineEntry.getD r 0) with
  | some c => decide (c ≤ routineCost)
  | none => false
/-- Jump-table target of field `f` (T8E: rank = field; fields `≥ 563` are rejected by the digest search). -/
def jtTarget (f : Nat) : Nat := routineEntry.getD f 0
def jtOK (f : Nat) : Bool :=
  match expLook (jt0 + f) with
  | some w => jalTo w (jt0 + f) == some (jtTarget f)
  | none => false
end ClaudeWCT.W9.Machine.Expand
