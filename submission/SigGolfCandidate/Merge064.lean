      t3n [h8,h16,h17,h28,ofNat_and1,hbit,destination]
      norm_num [ofNat_and1,hbit,ofNat_add_ofNat,ofNat_eq_iff]
      split_ifs <;> (first | rfl | omega)
  · rcases Nat.mod_two_eq_zero_or_one child with hbit | hbit
