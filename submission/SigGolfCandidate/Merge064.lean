    (s : MachineState) (hp : s.pc = pcOf b) (region source child slot : Nat)
    (hr0 : 2968 ≤ region) (hr1 : region ≤ 10152) (hra : region % 8 = 0)
    (hs0 : 28672 ≤ source) (hs1 : source ≤ 31000) (hsa : source % 8 = 0)
