    last_setup hj hcode hu hlo v s hs
  have H : ∀ ans : BitVec 256,TBSim im sk (writeHash t ans) 1
      (pure (if topHi j then ans.extractLsb' 128 128 else ans.extractLsb' 0 128)) (HandPost B j u) := by
