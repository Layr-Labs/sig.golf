    · rfl
    · simp only [BC.recoverMsg,Fin.ofNat_zero,ite_true,Nat.zero_eq,bind_assoc,pure_bind,run,List.nil_append]
      all_goals (congr 1; funext vn; rcases vn with ⟨f,nn⟩; rfl)
  | succ n ih =>
